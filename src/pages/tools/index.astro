---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Tools — V.T.R. Ravi Kumar"
  description="Small, practical tools and calculators built by V.T.R. Ravi Kumar."
>
  <main id="main-content" class="tools-page" tabindex="-1">
    <header>
      <p class="eyebrow">A growing collection</p>
      <h1 class="type-page-heading">Useful tools.</h1>
      <p>Small utilities and calculators for creators, builders and the curious.</p>
    </header>
    <section aria-label="Available tools">
      <a class="tool-card" href="/tools/x-payout-calculator/">
        <span class="number">01 · CREATOR ECONOMY</span>
        <div>
          <h2>X payout calculator <span aria-hidden="true">↗</span></h2>
          <p>Estimate potential Original Content Rewards using qualified impressions and an adjustable payout assumption.</p>
        </div>
        <span class="availability">Available now</span>
      </a>
    </section>
  </main>
</BaseLayout>

<style>
.tools-page{width:min(1000px,calc(100% - 3rem));margin:0 auto;padding-bottom:6rem}
header{padding:7rem 0 4rem}
.eyebrow{margin:0 0 1rem;color:var(--accent);font-size:.72rem;font-weight:700;letter-spacing:.13em;text-transform:uppercase}
h1{margin:0;letter-spacing:-.055em}
header>p:last-child{max-width:600px;color:var(--muted);font-size:1.15rem;line-height:1.6}
section{border-top:1px solid var(--border)}
.tool-card{display:flex;flex-direction:column;gap:1.4rem;padding:2rem 0;border-bottom:1px solid var(--border);color:inherit;text-decoration:none}
.tool-card:hover{color:inherit}
.number,.availability{font-size:.7rem;font-weight:650;letter-spacing:.1em;color:var(--muted);text-transform:uppercase}
h2{margin:0;font-size:clamp(1.8rem,4vw,3rem);letter-spacing:-.045em}
h2 span{color:var(--accent);font-size:.75em}
.tool-card p{max-width:650px;margin:.6rem 0 0;color:var(--muted);line-height:1.6}
.availability{align-self:flex-start;padding:.45rem .7rem;border:1px solid var(--border);border-radius:99px;letter-spacing:.04em;text-transform:none}
@media(max-width:600px){.tools-page{width:min(100% - 2rem,1000px)}header{padding:4.5rem 0 3rem}}
</style>
