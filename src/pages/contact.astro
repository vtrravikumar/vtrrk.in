---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Contact — V.T.R. Ravi Kumar" description="Contact V.T.R. Ravi Kumar."><main><header><p class="label">Contact</p><h1>Get in touch.</h1><p>The simplest way to reach me is through my public profiles.</p></header><section><a href="https://x.com/vtrrk" target="_blank" rel="noopener noreferrer">X / @vtrrk →</a><a href="https://www.instagram.com/vtrravikumar/" target="_blank" rel="noopener noreferrer">Instagram / @vtrravikumar →</a></section></main></BaseLayout>
<style>main{width:min(850px,calc(100% - 3rem));margin:0 auto}header{padding:8rem 0 5rem}h1{margin:0;font-size:clamp(3rem,7vw,6rem);letter-spacing:-.05em}header>p:last-child{color:var(--muted);font-size:1.2rem;line-height:1.6}.label{color:var(--muted);font-size:.78rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase}section{border-top:1px solid color-mix(in srgb,var(--foreground) 15%,transparent)}section a{display:block;padding:2rem 0;border-bottom:1px solid color-mix(in srgb,var(--foreground) 15%,transparent);font-size:1.3rem}@media(max-width:600px){main{width:min(100% - 2rem,850px)}header{padding:5rem 0 3rem}}
</style>
