---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Elsewhere — V.T.R. Ravi Kumar" description="Find V.T.R. Ravi Kumar elsewhere online."><main><header><p class="label">Elsewhere</p><h1>Other places to find me.</h1></header><section><a href="https://x.com/vtrrk" target="_blank" rel="noopener noreferrer">X <span>@vtrrk</span></a><a href="https://www.instagram.com/vtrravikumar/" target="_blank" rel="noopener noreferrer">Instagram <span>@vtrravikumar</span></a><a href="https://500px.com/vtrrk" target="_blank" rel="noopener noreferrer">500px <span>Photography</span></a></section></main></BaseLayout>
<style>main{width:min(850px,calc(100% - 3rem));margin:0 auto}header{padding:8rem 0 5rem}h1{margin:0;font-size:clamp(3rem,7vw,6rem);line-height:1;letter-spacing:-.05em}.label{color:var(--muted);font-size:.78rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase}section{border-top:1px solid color-mix(in srgb,var(--foreground) 15%,transparent)}a{display:flex;justify-content:space-between;gap:2rem;padding:2rem 0;border-bottom:1px solid color-mix(in srgb,var(--foreground) 15%,transparent);color:inherit;text-decoration:none;font-size:1.3rem}span{color:var(--muted);font-size:1rem}@media(max-width:600px){main{width:min(100% - 2rem,850px)}header{padding:5rem 0 3rem}a{display:block}span{display:block;margin-top:.4rem}}
</style>
