---
import BaseLayout from "../layouts/BaseLayout.astro";

const topics = [
  "Technology & AI",
  "Photography",
  "Royal Enfield & Riding",
  "Travel & Exploration",
  "Life & Observations",
  "Surprise me",
];
---

<BaseLayout
  title="Tweet Creator — V.T.R. Ravi Kumar"
  description="Create a concise, personalized tweet with AI."
>
  <main>
    <header>
      <p class="label">Tweet Creator</p>
      <h1>Something worth posting.</h1>
      <p>
        A small writing tool for turning an idea into a concise tweet in my voice.
        Review it, edit it, then post it yourself.
      </p>
    </header>

    <section class="creator" aria-label="Tweet creator">
      <div class="controls">
        <label>
          <span>Topic</span>
          <select id="topic">
            {topics.map((topic) => <option value={topic}>{topic}</option>)}
          </select>
        </label>

        <label>
          <span>Location <em>optional</em></span>
          <input id="location" type="text" placeholder="e.g. Chennai" maxlength="80" />
        </label>
      </div>

      <div class="actions">
        <button id="create" type="button">Create Tweet</button>
        <span id="status" role="status" aria-live="polite"></span>
      </div>

      <div id="result-wrap" class="result-wrap" hidden>
        <label for="tweet">Your tweet</label>
        <textarea id="tweet" maxlength="140" rows="5" spellcheck="true"></textarea>
        <div class="result-footer">
          <span id="count">0 / 140</span>
          <button id="copy" type="button" class="secondary">Copy Tweet</button>
        </div>
        <button id="another" type="button" class="text-button">Create Another</button>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const API_URL = "https://tweetpilot-api.vtrravikumar.workers.dev/v1/tweet/generate";
  const DEFAULT_MAX_LENGTH = 140;
  const USAGE_KEY_STORAGE = "vichar.usageKey";

  function getUsageKey() {
    const existing = window.localStorage.getItem(USAGE_KEY_STORAGE)?.trim();
    if (existing && existing.length >= 20) return existing;

    const key = crypto.randomUUID();
    window.localStorage.setItem(USAGE_KEY_STORAGE, key);
    return key;
  }

  const topic = document.querySelector("#topic");
  const location = document.querySelector("#location");
  const create = document.querySelector("#create");
  const another = document.querySelector("#another");
  const copy = document.querySelector("#copy");
  const tweet = document.querySelector("#tweet");
  const count = document.querySelector("#count");
  const status = document.querySelector("#status");
  const resultWrap = document.querySelector("#result-wrap");

  const topics = Array.from(topic.options).map((option) => option.value);
  let lastTopic = "";

  function updateCount() {
    const length = tweet.value.length;
    count.textContent = `${length} / ${DEFAULT_MAX_LENGTH}`;
    count.toggleAttribute("data-over", length > DEFAULT_MAX_LENGTH);
  }

  function chooseTopic() {
    if (topic.value !== "Surprise me") return topic.value;
    const choices = topics.filter((value) => value !== "Surprise me" && value !== lastTopic);
    return choices[Math.floor(Math.random() * choices.length)] ?? topics[0];
  }

  async function generate() {
    const selectedTopic = chooseTopic();
    lastTopic = selectedTopic;

    create.disabled = true;
    another.disabled = true;
    status.textContent = "Creating…";
    status.removeAttribute("data-error");

    try {
      const response = await fetch(API_URL, {
        method: "POST",
        headers: {
          "content-type": "application/json",
          authorization: `Bearer ${getUsageKey()}`,
        },
        body: JSON.stringify({
          topic: selectedTopic,
          location: location.value.trim(),
          style: "thoughtful",
          maxLength: DEFAULT_MAX_LENGTH,
        }),
      });

      const payload = await response.json().catch(() => ({}));

      if (!response.ok || typeof payload.tweet !== "string") {
        const errorMessage =
          payload?.error && typeof payload.error === "object"
            ? payload.error.message
            : payload?.error;
        throw new Error(errorMessage || "Tweet creation failed.");
      }

      tweet.value = payload.tweet;
      resultWrap.hidden = false;
      updateCount();
      status.textContent = selectedTopic === topic.value
        ? "Ready to review."
        : `Ready to review · ${selectedTopic}`;
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : "Something went wrong.";
      status.setAttribute("data-error", "");
    } finally {
      create.disabled = false;
      another.disabled = false;
    }
  }

  create.addEventListener("click", generate);
  another.addEventListener("click", generate);
  tweet.addEventListener("input", updateCount);

  copy.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(tweet.value);
      copy.textContent = "Copied";
      window.setTimeout(() => { copy.textContent = "Copy Tweet"; }, 1400);
    } catch {
      tweet.focus();
      tweet.select();
      status.textContent = "Select the tweet and copy it manually.";
    }
  });
</script>

<style>
  main{width:min(900px,calc(100% - 3rem));margin:0 auto}
  header{padding:8rem 0 5rem}
  h1{margin:0;font-size:clamp(3rem,7vw,6rem);line-height:.98;letter-spacing:-.05em}
  header>p:last-child{max-width:650px;color:var(--muted);font-size:1.2rem;line-height:1.7}
  .label{color:var(--muted);font-size:.78rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase}
  .creator{border-top:1px solid color-mix(in srgb,var(--foreground) 15%,transparent);padding:3rem 0 6rem}
  .controls{display:grid;grid-template-columns:1.2fr .8fr;gap:1rem}
  label{display:grid;gap:.55rem;color:var(--muted);font-size:.82rem;font-weight:600}
  label em{font-style:normal;font-weight:400;opacity:.7}
  select,input,textarea{width:100%;box-sizing:border-box;border:1px solid var(--border);border-radius:1rem;background:var(--surface);color:var(--foreground);font:inherit;outline:none}
  select,input{height:3.2rem;padding:0 1rem}
  textarea{min-height:9rem;padding:1.1rem 1.2rem;resize:vertical;line-height:1.55}
  select:focus,input:focus,textarea:focus{border-color:var(--foreground)}
  .actions{display:flex;align-items:center;gap:1rem;margin-top:1.5rem}
  button{border:0;border-radius:999px;background:var(--foreground);color:var(--background);font:inherit;font-weight:700;padding:.8rem 1.2rem;cursor:pointer}
  button:hover{opacity:.88}
  button:disabled{opacity:.45;cursor:wait}
  .secondary{background:transparent;color:var(--foreground);border:1px solid var(--border)}
  #status{color:var(--muted);font-size:.85rem}
  #status[data-error]{color:var(--foreground)}
  .result-wrap{margin-top:3rem}
  .result-wrap>label{font-size:.78rem;letter-spacing:.1em;text-transform:uppercase}
  .result-footer{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:.8rem}
  #count{color:var(--muted);font-size:.78rem}
  #count[data-over]{color:var(--foreground);font-weight:700}
  .text-button{margin-top:1.5rem;background:transparent;color:var(--muted);padding:.3rem 0}
  .text-button:hover{color:var(--foreground);opacity:1}
  @media(max-width:650px){
    main{width:min(100% - 2rem,900px)}
    header{padding:5rem 0 3rem}
    .controls{grid-template-columns:1fr}
  }
</style>
