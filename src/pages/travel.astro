---
import BaseLayout from "../layouts/BaseLayout.astro";
import { travelCountries } from "../content/travel-countries";

const continents = ["Asia", "Europe", "Africa", "Oceania", "North America"];
const visited = travelCountries.filter((country) => country.status === "Y");
const hasBlog = (country: (typeof travelCountries)[number]) => country.hasBlog;
---
<BaseLayout title="Travel — V.T.R. Ravi Kumar" description="Travel stories, journeys and practical notes from V.T.R. Ravi Kumar."><main><header><p class="label">Travel</p><h1>Twenty years on the road.</h1><p>Countries, journeys and the stories behind them — with practical notes on what worked, what didn't and what I would do differently.</p></header><section class="index"><div class="index-intro"><p class="label">Travel index</p><h2>{visited.length} countries visited</h2><p>Organised by continent. A green marker means a travelogue is available; a grey marker means the journey is recorded but the story is still to be written.</p></div>{continents.map((continent) => { const countries = visited.filter((country) => country.continent === continent); if (!countries.length) return null; return <section class="continent"><h3>{continent}</h3><div class="countries">{countries.map((country) => <div class:list-item={true} class:has-blog={hasBlog(country)}><span class="status" aria-label={hasBlog(country) ? "Travelogue available" : "Travelogue not yet written"}></span>{hasBlog(country) ? <a href={`/travel/${country.slug}/`}>{country.name}</a> : <span>{country.name}</span>}</div>)}</div></section>})}</section></main></BaseLayout>
<style>main{width:min(1000px,calc(100% - 3rem));margin:0 auto}header{padding:7rem 0 5rem;max-width:850px}h1{margin:0;font-size:clamp(2.75rem,5.5vw,4.5rem);line-height:1;letter-spacing:-.045em}header>p:last-child{max-width:700px;color:var(--muted);font-size:1.2rem;line-height:1.7}.label{color:var(--muted);font-size:.78rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase}.index{border-top:1px solid color-mix(in srgb,var(--foreground) 15%,transparent);padding:4rem 0 7rem}.index-intro{max-width:700px;margin-bottom:5rem}.index-intro h2{margin:.5rem 0 1rem;font-size:2.4rem;line-height:1.1}.index-intro p:last-child{color:var(--muted);line-height:1.7}.continent{border-top:1px solid color-mix(in srgb,var(--foreground) 15%,transparent);padding:2rem 0 3rem}.continent h3{margin:0 0 1.5rem;font-size:1.1rem;letter-spacing:.04em}.countries{display:grid;grid-template-columns:repeat(3,1fr);gap:.2rem 2rem}.list-item{display:flex;align-items:center;gap:.65rem;min-height:2.4rem;color:var(--muted)}.list-item.has-blog{color:var(--foreground)}.list-item a{color:inherit;text-decoration:none}.list-item a:hover{text-decoration:underline}.status{width:.5rem;height:.5rem;border-radius:50%;background:#b5b5b5;flex:0 0 auto}.has-blog .status{background:#3b8f5a}@media(max-width:700px){main{width:min(100% - 2rem,1000px)}header{padding:5rem 0 3rem}.countries{grid-template-columns:repeat(2,1fr)}.index{padding-top:3rem}}@media(max-width:450px){.countries{grid-template-columns:1fr}}
</style>
