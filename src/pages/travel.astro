---
import BaseLayout from "../layouts/BaseLayout.astro";
import { load } from "js-yaml";
import { travelCountries } from "../content/travel-countries";

const continents = ["Asia", "Europe", "Africa", "Oceania", "North America"];
const visited = travelCountries.filter((country) => country.status === "Y");
const international = visited.filter((country) => country.slug !== "india");
const published = international.filter((country) => country.hasBlog);

// India is organised as individual journeys rather than countries or states.
const indiaJourneyModules = import.meta.glob("../content/travel/india/*/*.yaml", { eager: true, query: "?raw", import: "default" });
const indiaJourneys = Object.entries(indiaJourneyModules).map(([path, raw]) => {
  const data = load(raw as string) as { title: string; region?: string; banner?: string; featured?: boolean };
  const slug = path.split("/").at(-2) ?? data.title.toLowerCase().replace(/\s+/g, "-");
  return { ...data, slug };
});
const featuredIndia = indiaJourneys[Math.floor(Math.random() * indiaJourneys.length)];
const fallbackWorld = published[0];
const hasBlog = (country: (typeof travelCountries)[number]) => country.hasBlog;
---
<BaseLayout title="Travel — V.T.R. Ravi Kumar" description="Travel stories, journeys and practical notes from V.T.R. Ravi Kumar.">
  <main>
    <header>
      <p class="label">Travel</p>
      <h1>Twenty years on the road.</h1>
      <p>Countries, journeys and the stories behind them — with practical notes on what worked, what didn't and what I would do differently.</p>
    </header>

    <section class="featured" aria-labelledby="featured-heading">
      <p class="label" id="featured-heading">Featured travel</p>
      <div class="featured-grid">
        <article class="feature-column">
          <p class="feature-label">India</p>
          {featuredIndia ? (
            <a class="featured-card" href={`/travel/india/${featuredIndia.slug}/`} data-india-featured-card>
              <img src={featuredIndia.banner ?? `/images/travel/${featuredIndia.slug}.jpg`} alt={`${featuredIndia.title} travel banner`} data-india-featured-image />
              <div class="featured-copy">
                <p class="featured-continent">India · {featuredIndia.region ?? "Journey"}</p>
                <h2 data-india-featured-name>{featuredIndia.title}</h2>
                <p class="featured-link">Read the travelogue →</p>
              </div>
            </a>
          ) : (
            <div class="featured-card unavailable">
              <div class="featured-placeholder"><span>India</span></div>
              <div class="featured-copy">
                <p class="featured-continent">India journeys</p>
                <h2>Coming soon</h2>
                <p class="featured-link">The first journey will appear here.</p>
              </div>
            </div>
          )}
        </article>

        <article class="feature-column">
          <p class="feature-label">Rest of the world</p>
          {fallbackWorld && (
            <a class="featured-card" href={`/travel/${fallbackWorld.slug}/`} data-featured-card>
              <img src={`/images/travel/${fallbackWorld.slug}.jpg`} alt="" data-featured-image />
              <div class="featured-copy">
                <p class="featured-continent" data-featured-continent>{fallbackWorld.continent}</p>
                <h2 data-featured-name>{fallbackWorld.name}</h2>
                <p class="featured-link">Read the travelogue →</p>
              </div>
            </a>
          )}
        </article>
      </div>
    </section>

    <section class="index">
      <div class="index-intro">
        <p class="label">Travel index</p>
        <h2>India &amp; {international.length} countries</h2>
        <p>India is organised as individual journeys. The rest of the world is organised by country. A green marker means a travelogue is available; a grey marker means the journey is recorded but the story is still to be written.</p>
      </div>

      <section class="india-entry">
        <div>
          <p class="section-label">India</p>
          <h3>Journeys across India</h3>
          <p>Individual trips, routes and stories — not a list of states.</p>
        </div>
        <a href="/travel/india/">View India journeys →</a>
      </section>

      <section class="world">
        <p class="section-label">Rest of the world</p>
        {continents.map((continent) => {
          const countries = international.filter((country) => country.continent === continent);
          if (!countries.length) return null;
          return <section class="continent"><h3>{continent}</h3><div class="countries">{countries.map((country) => <div class:list-item={true} class:has-blog={hasBlog(country)}><span class="status" aria-label={hasBlog(country) ? "Travelogue available" : "Travelogue not yet written"}></span>{hasBlog(country) ? <a href={`/travel/${country.slug}/`}>{country.name}</a> : <span>{country.name}</span>}</div>)}</div></section>;
        })}
      </section>
    </section>
  </main>
</BaseLayout>

{published.length > 1 && (
  <script define:vars={{ published }}>
    const countries = published;
    const country = countries[Math.floor(Math.random() * countries.length)];
    const card = document.querySelector('[data-featured-card]');
    const image = document.querySelector('[data-featured-image]');
    const continent = document.querySelector('[data-featured-continent]');
    const name = document.querySelector('[data-featured-name]');

    if (card && image && continent && name) {
      card.setAttribute('href', `/travel/${country.slug}/`);
      image.setAttribute('src', `/images/travel/${country.slug}.jpg`);
      image.setAttribute('alt', `${country.name} travel banner`);
      continent.textContent = country.continent;
      name.textContent = country.name;
    }
  </script>
)}

<style>
main{width:min(1000px,calc(100% - 3rem));margin:0 auto}header{padding:7rem 0 5rem;max-width:850px}h1{margin:0;font-size:clamp(2.75rem,5.5vw,4.5rem);line-height:1;letter-spacing:-.045em}header>p:last-child{max-width:700px;color:var(--muted);font-size:1.2rem;line-height:1.7}.label,.section-label,.feature-label{color:var(--muted);font-size:.78rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase}.featured{border-top:1px solid color-mix(in srgb,var(--foreground) 15%,transparent);padding:3rem 0 5rem}.featured-grid{display:grid;grid-template-columns:1fr 1fr;gap:2rem;margin-top:1.25rem}.feature-label{margin:0 0 .75rem}.featured-card{display:grid;grid-template-columns:1fr 1fr;min-height:260px;height:100%;color:inherit;text-decoration:none;border:1px solid color-mix(in srgb,var(--foreground) 12%,transparent);overflow:hidden}.featured-card img,.featured-placeholder{width:100%;height:100%;min-height:260px;object-fit:cover;display:block}.featured-placeholder{display:flex;align-items:center;justify-content:center;background:color-mix(in srgb,var(--foreground) 5%,transparent);font-size:2rem;font-weight:500}.featured-placeholder span{opacity:.45}.featured-copy{display:flex;flex-direction:column;justify-content:center;padding:2rem}.featured-continent{margin:0 0 .5rem;color:var(--muted);font-size:.72rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase}.featured-copy h2{margin:0;font-size:clamp(1.8rem,3vw,2.8rem);line-height:1;letter-spacing:-.04em}.featured-link{margin:1.5rem 0 0;color:var(--muted)}.featured-card:hover .featured-link{text-decoration:underline}.unavailable{cursor:default}.index{border-top:1px solid color-mix(in srgb,var(--foreground) 15%,transparent);padding:4rem 0 7rem}.index-intro{max-width:700px;margin-bottom:4rem}.index-intro h2{margin:.5rem 0 1rem;font-size:2.4rem;line-height:1.1}.index-intro p:last-child{color:var(--muted);line-height:1.7}.india-entry{border-top:1px solid color-mix(in srgb,var(--foreground) 15%,transparent);border-bottom:1px solid color-mix(in srgb,var(--foreground) 15%,transparent);padding:2rem 0;display:flex;justify-content:space-between;align-items:center;gap:2rem}.india-entry h3{margin:.35rem 0 .5rem;font-size:1.7rem}.india-entry p{margin:0;color:var(--muted)}.india-entry a{color:inherit;text-decoration:none;white-space:nowrap}.india-entry a:hover{text-decoration:underline}.world{padding-top:4rem}.continent{border-top:1px solid color-mix(in srgb,var(--foreground) 15%,transparent);padding:2rem 0 3rem}.continent h3{margin:0 0 1.5rem;font-size:1.1rem;letter-spacing:.04em}.countries{display:grid;grid-template-columns:repeat(3,1fr);gap:.2rem 2rem}.list-item{display:flex;align-items:center;gap:.65rem;min-height:2.4rem;color:var(--muted)}.list-item.has-blog{color:var(--foreground)}.list-item a{color:inherit;text-decoration:none}.list-item a:hover{text-decoration:underline}.status{width:.6rem;height:.6rem;border-radius:50%;background:#b5b5b5;flex:0 0 auto}.has-blog .status{background:#3b8f5a}@media(max-width:800px){.featured-grid{grid-template-columns:1fr}}@media(max-width:700px){main{width:min(100% - 2rem,1000px)}header{padding:5rem 0 3rem}.featured{padding:2.5rem 0 4rem}.featured-card{grid-template-columns:1fr}.featured-card img,.featured-placeholder{min-height:220px}.featured-copy{padding:2rem}.india-entry{display:block}.india-entry a{display:inline-block;margin-top:1rem}.countries{grid-template-columns:repeat(2,1fr)}.index{padding-top:3rem}}@media(max-width:450px){.countries{grid-template-columns:1fr}}
</style>
