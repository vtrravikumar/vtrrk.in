g>p:last-child{margin:0;color:var(--muted);font-size:.85rem}.india-place-group{border-top:1px solid color-mix(in srgb,var(--foreground) 8%,transparent)}.india-place-group:last-child{border-bottom:1px solid color-mix(in srgb,var(--foreground) 8%,transparent)}.india-place-group summary{display:flex;justify-content:space-between;align-items:center;padding:1rem 0;cursor:pointer;list-style:none}.india-place-group summary::-webkit-details-marker,.india-place-entry summary::-webkit-details-marker{display:none}.india-place-toggle{font-size:1.2rem;color:var(--muted);transition:transform .2s ease}.india-place-group[open] .india-place-toggle{transform:rotate(45deg)}.india-places-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.4rem 2rem;padding:0 0 1.4rem}.india-places-list>a,.india-place-entry summary{color:var(--muted);font-size:.9rem;text-decoration:none}.india-places-list>a:hover,.india-place-entry summary:hover{color:var(--foreground)}.india-place-entry summary{display:flex;justify-content:space-between;gap:1rem;padding:.35rem 0;cursor:pointer}.india-place-count{font-size:.72rem;opacity:.65}.india-journey-list{display:flex;flex-direction:column;gap:.25rem;padding:.2rem 0 .4rem 1rem}.india-journey-list a{color:var(--foreground);font-size:.82rem;text-decoration:none}.uae{padding:4rem 0;border-bottom:1px solid color-mix(in srgb,var(--foreground) 12%,transparent)}.uae-heading{max-width:780px;margin-bottom:2rem}.uae-emirates{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;border-top:1px solid color-mix(in srgb,var(--foreground) 8%,transparent)}.uae-emirate{display:flex;align-items:center;gap:.6rem;padding:1rem 0;border-bottom:1px solid color-mix(in srgb,var(--foreground) 8%,transparent);color:var(--muted);font-size:.9rem}.uae-emirate.has-blog{color:var(--foreground)}.uae-emirate.has-blog{text-decoration:none}.uae-emirate .status,.countries .status{width:7px;height:7px;border-radius:50%;background:color-mix(in srgb,var(--foreground) 22%,tran