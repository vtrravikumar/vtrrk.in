---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { travelCountries } from "../content/travel-countries";

type JourneyEntry = Awaited<ReturnType<typeof getCollection<"travel">>>[number];

const journeys = await getCollection("travel");
const publishedJourneys = journeys.filter((journey) => journey.data.content_status === "published");
const slugFor = (entry: JourneyEntry) => {
  const parts = entry.id.split("/");
  return parts[0] === "india" ? `india/${parts[1]}` : parts[0];
};
const slugForData = (entry: JourneyEntry) => slugFor(entry);

const continents = ["Asia", "Europe", "Africa", "Oceania", "North America"];
const visitedCountries = travelCountries.filter((country) => country.status === "Y");
const international = visitedCountries
  .filter((country) => country.slug !== "india")
  .map((country) => {
    const entry = journeys.find((journey) => slugForData(journey) === country.slug);
    return { ...country, ...(entry ? entry.data : {}), slug: country.slug };
  });
const published = international.filter((country) => country.content_status === "published");

const indiaJourneys = publishedJourneys
  .filter((journey) => slugFor(journey).startsWith("india/"))
  .map((entry) => ({ ...entry.data, slug: slugFor(entry), places_visited: [...new Set((entry.data.visits ?? []).flatMap((visit) => visit.places_visited ?? []))] }));

const allVisits = publishedJourneys.flatMap((journey) => journey.data.visits ?? []);
const flightsTaken = allVisits.reduce((total, visit) => total + (visit.flights?.length ?? 0), 0);
const trainJourneys = allVisits.filter((visit) => {
  const transport = [visit.travel_type, ...(visit.transport ?? [])]
    .filter(Boolean)
    .map((value) => String(value).toLowerCase())
    .join(" ");
  return transport.includes("train") || transport.includes("rail");
}).length;
const visitDurations = allVisits.filter((visit) => typeof visit.duration_days === "number" && visit.duration_days > 0);
const shortestTrip = visitDurations.reduce((shortest, visit) => !shortest || visit.duration_days! < shortest.duration_days! ? visit : shortest, null as (typeof visitDurations)[number] | null);
const longestTrip = visitDurations.reduce((longest, visit) => !longest || visit.duration_days! > longest.duration_days! ? visit : longest, null as (typeof visitDurations)[number] | null);
const latestVisit = [...allVisits].sort((a, b) => String(b.to).localeCompare(String(a.to)))[0];
const latestJourney = latestVisit ? publishedJourneys.find((journey) => (journey.data.visits ?? []).includes(latestVisit)) : null;
const latestJourneyLabel = latestJourney?.data.title ?? latestJourney?.id.split("/").pop() ?? "the latest journey";
const flightLabel = flightsTaken === 1 ? "flight" : "flights";
const trainLabel = trainJourneys === 1 ? "train journey" : "train journeys";

const placeCounts = new Map<string, number>();
for (const journey of publishedJourneys) {
  for (const visit of journey.data.visits ?? []) {
    for (const place of visit.places_visited ?? []) {
      placeCounts.set(place, (placeCounts.get(place) ?? 0) + 1);
    }
  }
}
const maxPlaceCount = Math.max(1, ...placeCounts.values());
const tagCloud = [...placeCounts.entries()]
  .sort(([aName, aCount], [bName, bCount]) => bCount - aCount || aName.localeCompare(bName))
  .slice(0, 24)
  .map(([name, count], index) => ({
    name,
    count,
    size: maxPlaceCount > 1 ? 0.86 + ((count - 1) / (maxPlaceCount - 1)) * 1.34 : 1,
    rotation: [-2, 1, -1, 2, 0][index % 5],
  }));

type IndiaPlaceGroup = Record<string, JourneyEntry["data"][]>;
const indiaPlaces = Object.entries(
  indiaJourneys.reduce<Record<string, IndiaPlaceGroup>>((groups, journey) => {
    const region = journey.region?.trim() || "Other places";
    const places = journey.places_visited.length ? journey.places_visited : [journey.title ?? journey.slug];
    groups[region] ??= {};
    for (const place of places) {
      groups[region][place] ??= [];
      groups[region][place].push(journey);
    }
    return groups;
  }, {})
).sort(([a], [b]) => a.localeCompare(b));

const featuredIndia = indiaJourneys[Math.floor(Math.random() * indiaJourneys.length)];
const fallbackWorld = published[0];
---
<BaseLayout title="Travel — V.T.R. Ravi Kumar" description="Travel stories, journeys and practical notes from V.T.R. Ravi Kumar.">
  <main>
    <header class="page-intro">
      <p class="label">Travel</p><h1>Twenty years on the road.</h1>
      <p>Countries, journeys and the stories behind them — with practical notes on what worked, what didn't and what I would do differently.</p>
    </header>
    <section class="travel-snapshot" aria-labelledby="travel-snapshot-heading">
      <p class="label" id="travel-snapshot-heading">A little travel arithmetic</p>
      <p class="travel-snapshot-copy">Across the journeys recorded here, I've taken {flightsTaken} {flightLabel} and {trainJourneys} {trainLabel}, with trips ranging from {shortestTrip?.duration_days ?? "—"} days to {longestTrip?.duration_days ?? "—"} days. The latest journey was {latestJourneyLabel}, while some places have been worth returning to — sometimes years apart, and sometimes with a completely different story.</p>
      <div class="tag-cloud" aria-label="Places from the journeys">
        {tagCloud.map((tag) => <span style={`--tag-size:${tag.size}rem;--tag-rotation:${tag.rotation}deg`}>{tag.name}</span>)}
      </div>
    </section>
    <section class="featured" aria-labelledby="featured-heading">
      <div class="section-heading"><p class="label" id="featured-heading">Featured travel</p><p class="section-note">A few places from the road</p></div>
      <div class="featured-grid">
        <article class="feature-column"><p class="feature-label">India</p>
          {featuredIndia ? <a class="featured-card" href={`/travel/india/${featuredIndia.slug.split("/").pop()}/`} data-india-featured-card><img src={featuredIndia.banner ?? `/images/travel/${featuredIndia.slug.split("/").pop()}.jpg`} alt={`${featuredIndia.title} travel banner`} data-india-featured-image /><div class="featured-copy"><p class="featured-continent">India · {featuredIndia.region ?? "Journey"}</p><h2 data-india-featured-name>{featuredIndia.title}</h2><p class="featured-link">Read the travelogue <span>→</span></p></div></a> : <div class="featured-card unavailable"><div class="featured-placeholder"><span>India</span></div><div class="featured-copy"><p class="featured-continent">India journeys</p><h2>Coming soon</h2><p class="featured-link">The first journey will appear here.</p></div></div>}
        </article>
        <article class="feature-column"><p class="feature-label">Rest of the world</p>
          {fallbackWorld && <a class="featured-card" href={`/travel/${fallbackWorld.slug}/`} data-featured-card><img src={fallbackWorld.banner ?? `/images/travel/${fallbackWorld.slug}.jpg`} alt="" data-featured-image /><div class="featured-copy"><p class="featured-continent" data-featured-continent>{fallbackWorld.continent}</p><h2 data-featured-name>{fallbackWorld.title ?? fallbackWorld.name}</h2><p class="featured-link">Read the travelogue <span>→</span></p></div></a>}
        </article>
      </div>
    </section>
    <section class="index">
      <div class="index-intro"><p class="label">Travel index</p><h2>India &amp; {international.length} countries</h2><p>India is organised as individual journeys. The rest of the world is organised by country. A green marker means a published travelogue is available; a grey marker means the journey is recorded but the story is still to be written.</p></div>
      <section class="india-entry"><div><p class="section-label">India</p><h3>Journeys across India</h3><p>Individual trips, routes and stories — not a list of states.</p></div><a href="/travel/india/">View India journeys <span>→</span></a></section>
      <section class="india-places">
        <div class="india-places-heading"><p class="section-label">Places across India</p><p>States and places I've travelled through, shown only where there is a published journey to tell.</p></div>
        <div class="india-place-groups">
          {indiaPlaces.map(([region, places]) => (
            <details class="india-place-group">
              <summary><span>{region}</span><span class="india-place-toggle" aria-hidden="true">+</span></summary>
              <div class="india-places-list">
                {Object.entries(places).map(([place, placeJourneys]) => (
                  placeJourneys.length === 1
                    ? <a href={`/travel/india/${placeJourneys[0].slug.split("/").pop()}/`}>{place}</a>
                    : <details class="india-place-entry">
                        <summary><span>{place}</span><span class="india-place-count">{placeJourneys.length} journeys</span></summary>
                        <div class="india-journey-list">
                          {placeJourneys.map((journey) => <a href={`/travel/india/${journey.slug.split("/").pop()}/`}>{journey.title}</a>)}
                        </div>
                      </details>
                ))}
              </div>
            </details>
          ))}
        </div>
      </section>
      <section class="world"><p class="section-label">Rest of the world</p>{continents.map((continent) => { const countries = international.filter((country) => country.continent === continent); if (!countries.length) return null; return <section class="continent"><h3>{continent}</h3><div class="countries">{countries.map((country) => { const isPublished = country.content_status === "published"; return <div class:list-item={true} class:has-blog={isPublished}><span class="status" aria-label={isPublished ? "Travelogue available" : "Travelogue not yet written"}></span>{isPublished ? <a href={`/travel/${country.slug}/`}>{country.title ?? country.name}</a> : <span>{country.name}</span>}</div>; })}</div></section>; })}</section>
    </section>
  </main>
</BaseLayout>
{published.length > 1 && <script define:vars={{ published }}>{`const countries = published; const country = countries[Math.floor(Math.random() * countries.length)]; const card = document.querySelector('[data-featured-card]'); const image = document.querySelector('[data-featured-image]'); const continent = document.querySelector('[data-featured-continent]'); const name = document.querySelector('[data-featured-name]'); if (card && image && continent && name) { card.setAttribute('href', \`/travel/\${country.slug}/\`); image.setAttribute('src', country.banner ?? \`/images/travel/\${country.slug}.jpg\`); image.setAttribute('alt', \`\${country.title ?? country.name} travel banner\`); continent.textContent = country.continent; name.textContent = country.title ?? country.name; }`}</script>}
<script>
  const tagCloud = document.querySelector('.tag-cloud');
  if (tagCloud) {
    [...tagCloud.children]
      .sort(() => Math.random() - 0.5)
      .forEach((tag) => tagCloud.appendChild(tag));
  }
</script>
<style>
