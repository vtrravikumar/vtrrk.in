ansition:border-color .25s ease,transform .25s ease}.featured-card img,.featured-placeholder{width:100%;height:100%;min-height:310px;object-fit:cover;display:block}.featured-card img{transition:transform .5s cubic-bezier(.2,.7,.2,1)}.featured-card:hover{border-color:color-mix(in srgb,var(--foreground) 25%,transparent);transform:translateY(-2px)}.featured-card:hover img{transform:scale(1.035)}.featured-placeholder{display:flex;align-items:center;justify-content:center;background:color-mix(in srgb,var(--foreground) 5%,transparent);font-size:2rem;font-weight:500}.featured-placeholder span{opacity:.4}.featured-copy{display:flex;flex-direction:column;justify-content:center;padding:2.25rem}.featured-continent{margin:0 0 .65rem;color:var(--muted);font-size:.68rem;font-weight:650;letter-spacing:.11em;text-transform:uppercase}.featured-copy h2{margin:0;font-size:clamp(1.8rem,3vw,2.7rem);line-height:1.02;letter-spacing:-.035em}.featured-link{margin:1.6rem 0 0;color:var(--foreground);font-size:.9rem}.featured-link span{display:inline-block;margin-left:.25rem;transition:transform .2s ease}.featured-card:hover .featured-link span{transform:translateX(4px)}.unavailable{cursor:default}.index{padding-top:5.5rem;border-top:1px solid color-mix(in srgb,var(--foreground) 12%,transparent)}.index-intro{max-width:720px;margin-bottom:5rem}.index-intro h2{margin:.65rem 0 1.15rem;font-size:clamp(2.2rem,4.5vw,3.6rem);line-height:1;letter-spacing:-.045em}.index-intro p:last-child{margin:0;color:var(--muted);line-height:1.75}.india-entry{display:flex;justify-content:space-between;align-items:center;gap:3rem;padding:2.4rem 0;border-top:1px solid color-mix(in srgb,var(--foreground) 14%,transparent);border-bottom:1px solid color-mix(in srgb,var(--foreground) 14%,transparent)}.india-entry h3{margin:.45rem 0 .5rem;font-size:1.65rem;letter-spacing:-.02em}.india-entry p{margin:0;color:var(--muted)}.india-entry a{color:inherit;text-decoration:none;white-space:nowrap;font-size:.92rem}.india-entry a span{display:inline-block;margin-left:.3rem;transition:transform .2s ease}.india-entry a:hover{text-decoration:underline;text-underline-offset:.3em}.india-entry a:hover span{transform:translateX(4px)}.india-places{padding:4.5rem 0 5rem}.india-places-heading{display:flex;justify-content:space-between;align-items:baseline;gap:3rem;margin-bottom:2.25rem}.india-places-heading p:last-child{max-width:540px;margin:0;color:var(--muted);font-size:.88rem;line-height:1.6}.india-place-groups{display:grid;grid-template-columns:repeat(3,1fr);gap:0 3rem}.india-place-group{padding:0;border-top:1px solid color-mix(in srgb,var(--foreground) 10%,transparent)}.india-place-group summary{list-style:none;cursor:pointer}.india-place-group summary::-webkit-details-marker,.india-place-entry summary::-webkit-details-marker{display:none}.india-place-group>summary{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.25rem 0;font-size:1rem;font-weight:600}.india-place-toggle{font-size:1.2rem;font-weight:400;line-height:1;transition:transform .2s ease}.india-place-group[open] .india-place-toggle{transform:rotate(45deg)}.india-places-list{display:flex;flex-direction:column;gap:.3rem;padding:0 0 1.5rem}.india-places-list>a{font-size:.94rem;line-height:1.45;color:inherit;text-underline-offset:.25em;padding:.1rem 0}.india-place-entry{border-top:1px solid color-mix(in srgb,var(--foreground) 7%,transparent)}.india-place-entry summary{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.65rem 0;cursor:pointer;font-size:.94rem;line-height:1.45}.india-place-entry summary>span:first-child{color:inherit}.india-place-count{color:var(--muted);font-size:.72rem;white-space:nowrap}.india-journey-list{display:flex;flex-direction:column;gap:.25rem;padding:0 0 .8rem 1rem}.india-journey-list a{color:var(--muted);font-size:.86rem;text-underline-offset:.25em}.world{padding-top:5rem;border-top:1px solid color-mix(in srgb,var(--foreground) 10%,transparent)}.world>.section-label{margin-bottom:0}.continent{padding:2rem 0 3rem;border-top:1px solid color-mix(in srgb,var(--foreground) 10%,transparent);margin-top:1.5rem}.continent h3{margin:0 0 1.35rem;font-size:1rem;letter-spacing:.04em}.countries{display:grid;grid-template-columns:repeat(3,1fr);gap:.15rem 2rem}.list-item{display:flex;align-items:center;gap:.7rem;min-height:2.5rem;color:var(--muted);font-size:.95rem}.list-item.has-blog{color:var(--foreground)}.status{width:.45rem;height:.45rem;border-radius:50%;background:color-mix(in srgb,var(--foreground) 28%,transparent);flex:0 0 auto}.has-blog .status{background:#4f8a67}.list-item a{color:inherit;text-decoration:none}.list-item a:hover{text-decoration:underline;text-underline-offset:.25em}@media(max-width:850px){main{width:min(100% - 2rem,1080px)}.page-intro{padding:6rem 0 4.5rem}.featured-grid{grid-template-columns:1fr}.featured{padding-bottom:5.5rem}.india-place-groups{grid-template-columns:repeat(2,1fr)}}@media(max-width:650px){.section-heading{display:block}.section-note{margin-top:.5rem}.featured-card{grid-template-columns:1fr}.featured-card img,.featured-placeholder{min-height:240px}.featured-copy{padding:1.75rem}.index{padding-top:4rem}.index-intro{margin-bottom:4rem}.india-entry{display:block;padding:2rem 0}.india-entry a{display:inline-block;margin-top:1.25rem}.india-places{padding:3.5rem 0 4rem}.india-places-heading{display:block;margin-bottom:1.5rem}.india-place-groups{grid-template-columns:1fr 1fr;gap:0 1.5rem}.countries{grid-template-columns:1fr 1fr}.tag-cloud{gap:.2rem .8rem}.tag-cloud span{font-size:calc(var(--tag-size) * .82)}}@media(max-width:430px){.page-intro{padding:5rem 0 3.5rem}.page-intro h1{font-size:clamp(2.8rem,13vw,4rem)}.page-intro>p:last-child{font-size:1.05rem}.india-place-groups{grid-template-columns:1fr}.countries{grid-template-columns:1fr}.tag-cloud{gap:.15rem .65rem}.tag-cloud span{font-size:calc(var(--tag-size) * .78)}}
</style>