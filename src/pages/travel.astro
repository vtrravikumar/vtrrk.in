---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { travelCountries } from "../content/travel-countries";

type JourneyEntry = Awaited<ReturnType<typeof getCollection<"travel">>>[number];

const journeys = await getCollection("travel");
const publishedJourneys = journeys.filter((journey) => journey.data.content_status === "published");
const slugFor = (entry: JourneyEntry) => {
  const parts = entry.id.split("/");
  return parts[0] === "india" ? `india/${parts[1]}` : parts[0];
};
const slugForData = (entry: JourneyEntry) => slugFor(entry);

const continents = ["Asia", "Europe", "Africa", "Oceania", "North America"];
const visitedCountries = travelCountries.filter((country) => country.status === "Y");
const international = visitedCountries
  .filter((country) => country.slug !== "india")
  .map((country) => {
    const entry = journeys.find((journey) => slugForData(journey) === country.slug);
    return { ...country, ...(entry ? entry.data : {}), slug: country.slug };
  });
const published = international.filter((country) => country.content_status === "published");

const indiaJourneys = publishedJourneys
  .filter((journey) => slugFor(journey).startsWith("india/"))
  .map((entry) => ({ ...entry.data, slug: slugFor(entry), places_visited: [...new Set((entry.data.visits ?? []).flatMap((visit) => visit.places_visited ?? []))] }));

const indiaPlaces = Object.entries(
  indiaJourneys.reduce<Record<string, string[]>>((groups, journey) => {
    const region = journey.region?.trim() || "Other places";
    const places = journey.places_visited.length ? journey.places_visited : [journey.title ?? journey.slug];
    groups[region] ??= [];
    for (const place of places) if (!groups[region].includes(place)) groups[region].push(place);
    return groups;
  }, {})
).sort(([a], [b]) => a.localeCompare(b));

const featuredIndia = indiaJourneys[Math.floor(Math.random() * indiaJourneys.length)];
const fallbackWorld = published[0];
---
<BaseLayout title="Travel — V.T.R. Ravi Kumar" description="Travel stories, journeys and practical notes from V.T.R. Ravi Kumar.">
  <main>
    <header class="page-intro">
      <p class="label">Travel</p><h1>Twenty years on the road.</h1>
      <p>Countries, journeys and the stories behind them — with practical notes on what worked, what didn't and what I would do differently.</p>
    </header>
    <section class="featured" aria-labelledby="featured-heading">
      <div class="section-heading"><p class="label" id="featured-heading">Featured travel</p><p class="section-note">A few places from the road</p></div>
      <div class="featured-grid">
        <article class="feature-column"><p class="feature-label">India</p>
          {featuredIndia ? <a class="featured-card" href={`/travel/india/${featuredIndia.slug.split("/").pop()}/`} data-india-featured-card><img src={featuredIndia.banner ?? `/images/travel/${featuredIndia.slug.split("/").pop()}.jpg`} alt={`${featuredIndia.title} travel banner`} data-india-featured-image /><div class="featured-copy"><p class="featured-continent">India · {featuredIndia.region ?? "Journey"}</p><h2 data-india-featured-name>{featuredIndia.title}</h2><p class="featured-link">Read the travelogue <span>→</span></p></div></a> : <div class="featured-card unavailable"><div class="featured-placeholder"><span>India</span></div><div class="featured-copy"><p class="featured-continent">India journeys</p><h2>Coming soon</h2><p class="featured-link">The first journey will appear here.</p></div></div>}
        </article>
        <article class="feature-column"><p class="feature-label">Rest of the world</p>
          {fallbackWorld && <a class="featured-card" href={`/travel/${fallbackWorld.slug}/`} data-featured-card><img src={fallbackWorld.banner ?? `/images/travel/${fallbackWorld.slug}.jpg`} alt="" data-featured-image /><div class="featured-copy"><p class="featured-continent" data-featured-continent>{fallbackWorld.continent}</p><h2 data-featured-name>{fallbackWorld.title ?? fallbackWorld.name}</h2><p class="featured-link">Read the travelogue <span>→</span></p></div></a>}
        </article>
      </div>
    </section>
    <section class="index">
      <div class="index-intro"><p class="label">Travel index</p><h2>India &amp; {international.length} countries</h2><p>India is organised as individual journeys. The rest of the world is organised by country. A green marker means a published travelogue is available; a grey marker means the journey is recorded but the story is still to be written.</p></div>
      <section class="india-entry"><div><p class="section-label">India</p><h3>Journeys across India</h3><p>Individual trips, routes and stories — not a list of states.</p></div><a href="/travel/india/">View India journeys <span>→</span></a></section>
      <section class="india-places"><div class="india-places-heading"><p class="section-label">Places across India</p><p>States and places I've travelled through, shown only where there is a published journey to tell.</p></div><div class="india-place-groups">{indiaPlaces.map(([region, places]) => <section class="india-place-group"><h3>{region}</h3><div class="india-places-list">{places.map((place) => { const journey = indiaJourneys.find((item) => item.places_visited.includes(place)); return journey ? <a href={`/travel/india/${journey.slug.split("/").pop()}/`}>{place}</a> : <span>{place}</span>; })}</div></section>)}</div></section>
      <section class="world"><p class="section-label">Rest of the world</p>{continents.map((continent) => { const countries = international.filter((country) => country.continent === continent); if (!countries.length) return null; return <section class="continent"><h3>{continent}</h3><div class="countries">{countries.map((country) => { const isPublished = country.content_status === "published"; return <div class:list-item={true} class:has-blog={isPublished}><span class="status" aria-label={isPublished ? "Travelogue available" : "Travelogue not yet written"}></span>{isPublished ? <a href={`/travel/${country.slug}/`}>{country.title ?? country.name}</a> : <span>{country.name}</span>}</div>; })}</div></section>; })}</section>
    </section>
  </main>
</BaseLayout>
{published.length > 1 && <script define:vars={{ published }}>{`const countries = published; const country = countries[Math.floor(Math.random() * countries.length)]; const card = document.querySelector('[data-featured-card]'); const image = document.querySelector('[data-featured-image]'); const continent = document.querySelector('[data-featured-continent]'); const name = document.querySelector('[data-featured-name]'); if (card && image && continent && name) { card.setAttribute('href', \`/travel/\${country.slug}/\`); image.setAttribute('src', country.banner ?? \`/images/travel/\${country.slug}.jpg\`); image.setAttribute('alt', \`\${country.title ?? country.name} travel banner\`); continent.textContent = country.continent; name.textContent = country.title ?? country.name; }`}</script>}
<style>
main{width:min(1080px,calc(100% - 3rem));margin:0 auto;padding-bottom:7rem;color:var(--foreground)}.page-intro{padding:8rem 0 6rem;max-width:820px}.label,.section-label,.feature-label{margin:0;color:var(--muted);font-size:.72rem;font-weight:650;letter-spacing:.14em;text-transform:uppercase}.page-intro h1{margin:.65rem 0 1.5rem;font-size:clamp(3.2rem,7vw,6rem);line-height:.96;letter-spacing:-.055em}.page-intro>p:last-child{max-width:700px;margin:0;color:var(--muted);font-size:1.18rem;line-height:1.75}.featured{padding:0 0 7rem}.section-heading{display:flex;justify-content:space-between;align-items:baseline;gap:2rem;margin-bottom:1.25rem}.section-note{margin:0;color:var(--muted);font-size:.85rem}.featured-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem}.feature-label{margin:0 0 .7rem}.featured-card{position:relative;display:grid;grid-template-columns:1.08fr .92fr;min-height:310px;height:100%;color:inherit;text-decoration:none;background:color-mix(in srgb,var(--foreground) 3%,var(--background));border:1px solid color-mix(in srgb,var(--foreground) 10%,transparent);overflow:hidden;transition:border-color .25s ease,transform .25s ease}.featured-card img,.featured-placeholder{width:100%;height:100%;min-height:310px;object-fit:cover;display:block}.featured-card img{transition:transform .5s cubic-bezier(.2,.7,.2,1)}.featured-card:hover{border-color:color-mix(in srgb,var(--foreground) 25%,transparent);transform:translateY(-2px)}.featured-card:hover img{transform:scale(1.035)}.featured-placeholder{display:flex;align-items:center;justify-content:center;background:color-mix(in srgb,var(--foreground) 5%,transparent);font-size:2rem;font-weight:500}.featured-placeholder span{opacity:.4}.featured-copy{display:flex;flex-direction:column;justify-content:center;padding:2.25rem}.featured-continent{margin:0 0 .65rem;color:var(--muted);font-size:.68rem;font-weight:650;letter-spacing:.11em;text-transform:uppercase}.featured-copy h2{margin:0;font-size:clamp(1.8rem,3vw,2.7rem);line-height:1.02;letter-spacing:-.035em}.featured-link{margin:1.6rem 0 0;color:var(--foreground);font-size:.9rem}.featured-link span{display:inline-block;margin-left:.25rem;transition:transform .2s ease}.featured-card:hover .featured-link span{transform:translateX(4px)}.unavailable{cursor:default}.index{padding-top:5.5rem;border-top:1px solid color-mix(in srgb,var(--foreground) 12%,transparent)}.index-intro{max-width:720px;margin-bottom:5rem}.index-intro h2{margin:.65rem 0 1.15rem;font-size:clamp(2.2rem,4.5vw,3.6rem);line-height:1;letter-spacing:-.045em}.index-intro p:last-child{margin:0;color:var(--muted);line-height:1.75}.india-entry{display:flex;justify-content:space-between;align-items:center;gap:3rem;padding:2.4rem 0;border-top:1px solid color-mix(in srgb,var(--foreground) 14%,transparent);border-bottom:1px solid color-mix(in srgb,var(--foreground) 14%,transparent)}.india-entry h3{margin:.45rem 0 .5rem;font-size:1.65rem;letter-spacing:-.02em}.india-entry p{margin:0;color:var(--muted)}.india-entry a{color:inherit;text-decoration:none;white-space:nowrap;font-size:.92rem}.india-entry a span{display:inline-block;margin-left:.3rem;transition:transform .2s ease}.india-entry a:hover{text-decoration:underline;text-underline-offset:.3em}.india-entry a:hover span{transform:translateX(4px)}.india-places{padding:4.5rem 0 5rem}.india-places-heading{display:flex;justify-content:space-between;align-items:baseline;gap:3rem;margin-bottom:2.25rem}.india-places-heading p:last-child{max-width:540px;margin:0;color:var(--muted);font-size:.88rem;line-height:1.6}.india-place-groups{display:grid;grid-template-columns:repeat(3,1fr);gap:0 3rem}.india-place-group{padding:1.75rem 0 2rem;border-top:1px solid color-mix(in srgb,var(--foreground) 10%,transparent)}.india-place-group h3{margin:0 0 .75rem;font-size:1rem}.india-places-list{display:flex;flex-direction:column;gap:.3rem}.india-places-list a,.india-places-list span{font-size:.94rem;line-height:1.45}.india-places-list a{color:inherit;text-underline-offset:.25em}.india-places-list span{color:var(--muted)}.world{padding-top:5rem;border-top:1px solid color-mix(in srgb,var(--foreground) 10%,transparent)}.world>.section-label{margin-bottom:0}.continent{padding:2rem 0 3rem;border-top:1px solid color-mix(in srgb,var(--foreground) 10%,transparent);margin-top:1.5rem}.continent h3{margin:0 0 1.35rem;font-size:1rem;letter-spacing:.04em}.countries{display:grid;grid-template-columns:repeat(3,1fr);gap:.15rem 2rem}.list-item{display:flex;align-items:center;gap:.7rem;min-height:2.5rem;color:var(--muted);font-size:.95rem}.list-item.has-blog{color:var(--foreground)}.status{width:.45rem;height:.45rem;border-radius:50%;background:color-mix(in srgb,var(--foreground) 28%,transparent);flex:0 0 auto}.has-blog .status{background:#4f8a67}.list-item a{color:inherit;text-decoration:none}.list-item a:hover{text-decoration:underline;text-underline-offset:.25em}@media(max-width:850px){main{width:min(100% - 2rem,1080px)}.page-intro{padding:6rem 0 4.5rem}.featured-grid{grid-template-columns:1fr}.featured{padding-bottom:5.5rem}.india-place-groups{grid-template-columns:repeat(2,1fr)}}@media(max-width:650px){.section-heading{display:block}.section-note{margin-top:.5rem}.featured-card{grid-template-columns:1fr}.featured-card img,.featured-placeholder{min-height:240px}.featured-copy{padding:1.75rem}.index{padding-top:4rem}.index-intro{margin-bottom:4rem}.india-entry{display:block;padding:2rem 0}.india-entry a{display:inline-block;margin-top:1.25rem}.india-places{padding:3.5rem 0 4rem}.india-places-heading{display:block;margin-bottom:1.5rem}.india-places-heading p:last-child{margin-top:.55rem}.india-place-groups{grid-template-columns:1fr 1fr;gap:0 1.5rem}.countries{grid-template-columns:1fr 1fr}}@media(max-width:430px){.page-intro{padding:5rem 0 3.5rem}.page-intro h1{font-size:clamp(2.8rem,13vw,4rem)}.page-intro>p:last-child{font-size:1.05rem}.india-place-groups{grid-template-columns:1fr}.countries{grid-template-columns:1fr}}
</style>
