---
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const catalogPath = join(process.cwd(), "public/photography/catalog.json");
  const catalog = JSON.parse(await readFile(catalogPath, "utf-8"));
  return catalog.map((photo) => ({
    params: { id: photo.id },
    props: { photo },
  }));
}

const { photo } = Astro.props;
const pageUrl = `https://vtrrk.in/photography/photo/${photo.id}/`;
const imageUrl = `https://vtrrk.in/photography/${photo.file}`;
const shareText = `${photo.place} · ${photo.country}`;
const shareUrl = `https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(shareText)}`;
---
<BaseLayout
  title={`${photo.place} · ${photo.country} — V.T.R. Ravi Kumar`}
  description={`Photography from ${photo.place}, ${photo.country}.`}
  ogUrl={pageUrl}
  ogImage={imageUrl}
>
  <main>
    <header>
      <a class="back" href="/photography/">← Photography</a>
      <p class="label">Photography</p>
    </header>

    <figure class="viewer">
      <div class="frame">
        <img
          src={`/photography/${photo.file}`}
          alt={`${photo.place} · ${photo.country}`}
          width={photo.width}
          height={photo.height}
          draggable="false"
        />
      </div>
      <figcaption>{photo.place} · {photo.country}</figcaption>
    </figure>

    <nav class="actions" aria-label="Photo actions">
      <a href="/photography/">← Back to Photography</a>
      <a href={shareUrl} target="_blank" rel="noopener noreferrer">Share on X ↗</a>
    </nav>
  </main>
</BaseLayout>
<script>
  const image = document.querySelector(".viewer img");
  image?.addEventListener("contextmenu", (event) => event.preventDefault());
  image?.addEventListener("dragstart", (event) => event.preventDefault());
</script>
<style>
main{width:min(1200px,calc(100% - 3rem));margin:0 auto}header{padding:5rem 0 2rem;max-width:900px}.back{display:inline-block;margin-bottom:2rem;color:var(--muted);text-decoration:none}.label{color:var(--muted);font-size:.78rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase}.viewer{margin:0}.frame{padding:.7rem;border:1px solid color-mix(in srgb,var(--foreground) 18%,transparent);border-radius:1.5rem;background:color-mix(in srgb,var(--foreground) 3%,transparent);box-shadow:0 1rem 3rem color-mix(in srgb,var(--foreground) 8%,transparent)}.viewer img{display:block;width:100%;height:auto;max-height:78vh;object-fit:contain;border-radius:.9rem;user-select:none;-webkit-user-drag:none}.viewer figcaption{padding:.9rem .25rem;color:var(--muted);font-size:.85rem}.actions{display:flex;justify-content:space-between;gap:2rem;margin:2rem 0 4rem;border-top:1px solid color-mix(in srgb,var(--foreground) 15%,transparent);padding-top:1.5rem}.actions a{color:inherit;text-decoration:none;font-weight:600}@media(max-width:700px){main{width:min(100% - 2rem,1200px)}header{padding:3rem 0 1rem}.viewer img{max-height:none}.frame{padding:.45rem;border-radius:1rem}.viewer img{border-radius:.65rem}.actions{display:block}.actions a{display:block;margin:.75rem 0}}
</style>
