---
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import BaseLayout from "../../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const catalogPath = join(process.cwd(), "public/photography/catalog.json");
  const catalog = JSON.parse(await readFile(catalogPath, "utf-8"));
  const countries = [...new Set(catalog.filter((photo) => photo.categories?.includes("countries") && photo.country).map((photo) => photo.country))];

  return countries.map((country) => ({
    params: {
      country: country.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, ""),
    },
    props: {
      country,
      photos: catalog.filter((photo) => photo.categories?.includes("countries") && photo.country === country),
    },
  }));
}

const { country } = Astro.props;
const photos = Astro.props.photos;
const places = [...new Set(photos.map((photo) => photo.place).filter(Boolean))].map((place) => ({
  name: place,
  slug: place.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, ""),
  cover: photos.find((photo) => photo.place === place),
}));
---
<BaseLayout title={`${country} Photography — V.T.R. Ravi Kumar`} description={`Photography from ${country} by V.T.R. Ravi Kumar.`}>
  <main>
    <header>
      <a class="back" href="/photography/countries/">← Countries</a>
      <p class="label">Photography / Countries / {country}</p>
      <h1>{country}</h1>
      <p>{places.length} places in this portfolio.</p>
    </header>

    <section class="place-grid" aria-label={`Places in ${country}`}>
      {places.map((place) => (
        <a class="place" href={`/photography/countries/${Astro.params.country}/${place.slug}/`}>
          <div class="place-photo">
            <img src={`/photography/${place.cover.thumbnail}`} alt="" width={place.cover.width} height={place.cover.height} loading="lazy" />
            <span>{place.name}</span>
          </div>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>
<style>
main{width:min(1200px,calc(100% - 3rem));margin:0 auto}
header{padding:5rem 0 4rem;max-width:850px}
.back{display:inline-block;margin-bottom:3rem;color:var(--muted);text-decoration:none}
.label{color:var(--muted);font-size:.78rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase}
h1{margin:0;font-size:clamp(3.5rem,8vw,7rem);line-height:.9;letter-spacing:-.06em}
header>p:last-child{color:var(--muted);font-size:1.1rem}
.place-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem}
.place{display:block;color:inherit;text-decoration:none}.place-photo{position:relative;overflow:hidden;aspect-ratio:3 / 2;border-radius:1.25rem;background:color-mix(in srgb,var(--foreground) 5%,transparent)}
.place-photo img{display:block;width:100%;height:100%;object-fit:cover;object-position:center}.place-photo::after{content:"";position:absolute;inset:0;background:linear-gradient(transparent 35%,rgba(0,0,0,.7))}.place-photo span{position:absolute;z-index:1;left:1.25rem;right:1.25rem;bottom:1rem;font-size:clamp(2rem,4vw,3.5rem);font-weight:700;line-height:.9;letter-spacing:-.05em;color:white}
@media(max-width:900px){.place-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){main{width:min(100% - 2rem,1200px)}header{padding:3rem 0}.place-grid{grid-template-columns:1fr}}
</style>
