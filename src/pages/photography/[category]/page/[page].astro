---
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const catalogPath = join(process.cwd(), "public/photography/catalog.json");
const catalog = JSON.parse(await readFile(catalogPath, "utf-8"));
const PAGE_SIZE = 12;
const categoryNames = { countries: "Countries", portraits: "Portraits", landscapes: "Landscapes", model: "Model Portfolio", street: "Street", abstract: "Abstract" };

export async function getStaticPaths() {
  const categories = [...new Set(catalog.flatMap((photo) => photo.categories ?? []))];
  return categories.flatMap((category) => {
    const photos = catalog.filter((photo) => photo.categories?.includes(category));
    const pageCount = Math.ceil(photos.length / PAGE_SIZE);
    return Array.from({ length: Math.max(0, pageCount - 1) }, (_, index) => {
      const page = index + 2;
      return { params: { category, page: String(page) }, props: { photos } };
    });
  });
}

const { category, page: pageParam } = Astro.params;
const photos = Astro.props.photos;
const title = categoryNames[category] ?? category;
const page = Number(pageParam);
const pageCount = Math.ceil(photos.length / PAGE_SIZE);
const pagePhotos = photos.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
---
<BaseLayout title={`${title} Photography — Page ${page} — V.T.R. Ravi Kumar`} description={`${title} photography by V.T.R. Ravi Kumar.`}>
  <main>
    <header>
      <a class="back" href={`/photography/${category}/`}>← {title}</a>
      <p class="label">Photography / {title}</p>
      <h1>{title}</h1>
      <p>Page {page} of {pageCount}</p>
    </header>

    <section class="gallery" aria-label={`${title} photographs, page ${page}`}>
      {pagePhotos.map((photo) => (
        <figure>
          <a href={`/photography/${photo.file}`} target="_blank" rel="noopener noreferrer">
            <img src={`/photography/${photo.thumbnail}`} alt={photo.title} width={photo.width} height={photo.height} loading="lazy" />
          </a>
          <figcaption><span>{photo.place}</span><span>{photo.title}</span></figcaption>
        </figure>
      ))}
    </section>

    <nav class="pagination" aria-label="Photography pagination">
      <a href={page === 2 ? `/photography/${category}/` : `/photography/${category}/page/${page - 1}/`}>← Previous</a>
      {page < pageCount && <a href={`/photography/${category}/page/${page + 1}/`}>Next →</a>}
    </nav>
  </main>
</BaseLayout>
<style>
main{width:min(1200px,calc(100% - 3rem));margin:0 auto}header{padding:5rem 0 4rem;max-width:850px}.back{display:inline-block;margin-bottom:3rem;color:var(--muted);text-decoration:none}.label{color:var(--muted);font-size:.78rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase}h1{margin:0;font-size:clamp(3.5rem,8vw,7rem);line-height:.9;letter-spacing:-.06em}header>p:last-child{color:var(--muted);font-size:1.1rem}.gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem}figure{margin:0}figure a{display:block;overflow:hidden;border-radius:1.25rem;background:color-mix(in srgb,var(--foreground) 5%,transparent)}img{display:block;width:100%;height:auto}figcaption{display:flex;justify-content:space-between;gap:1rem;padding:.75rem .25rem 1.5rem;color:var(--muted);font-size:.85rem}.pagination{display:flex;justify-content:space-between;margin-top:1rem;border-top:1px solid color-mix(in srgb,var(--foreground) 15%,transparent);padding:1.5rem 0}.pagination a{color:inherit;text-decoration:none;font-weight:600}@media(max-width:900px){.gallery{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){main{width:min(100% - 2rem,1200px)}header{padding:3rem 0}.gallery{grid-template-columns:1fr}}
</style>
