---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { books } from "../../content/books";
---
<BaseLayout title="Books — V.T.R. Ravi Kumar" description="Books written by V.T.R. Ravi Kumar.">
<main id="main-content" tabindex="-1">
  <header class="page-head">
    <p class="label">Books</p>
    <h1>Stories, ideas and experiences in print.</h1>
    <p>Four books, each from a different part of the journey.</p>
  </header>

  <section class="books">
    {books.map((book, index) => (
      <article>
        <div class="cover-wrap"><img class={book.slug === "the-white-envelope" ? "cover-crop" : undefined} src={book.cover} alt={`Cover of ${book.title}`} /></div>
        <div class="book-copy">
          <p class="book-number">0{index + 1} · {book.edition === "free-digital" ? "Free digital edition" : "Published book"}</p>
          <h2>{book.title}</h2>
          {book.subtitle && <p class="subtitle">{book.subtitle}</p>}
          <p class="description">{book.description}</p>
          <div class="actions">
            <a href={`/books/${book.slug}/`}>About the book <span>→</span></a>
            <a href={book.access.url} target={book.access.type === "amazon" ? "_blank" : undefined} rel={book.access.type === "amazon" ? "noopener noreferrer" : undefined}>{book.access.label} <span>{book.access.type === "amazon" ? "↗" : "→"}</span></a>
          </div>
        </div>
      </article>
    ))}
  </section>
</main>
</BaseLayout>
<style>
main{width:min(1080px,calc(100% - 3rem));margin:0 auto;padding-bottom:7rem}.page-head{padding:8rem 0 6rem;max-width:850px}.label{margin:0 0 1rem;color:var(--muted);font-size:.72rem;font-weight:650;letter-spacing:.14em;text-transform:uppercase}.page-head h1{margin:0;font-size:clamp(3.2rem,7vw,6rem);line-height:.96;letter-spacing:-.055em}.page-head p:last-child{max-width:600px;margin:1.5rem 0 0;color:var(--muted);font-size:1.18rem;line-height:1.7}.books{border-top:1px solid color-mix(in srgb,var(--foreground) 12%,transparent)}.books article{display:grid;grid-template-columns:300px 1fr;gap:5rem;align-items:center;padding:5.5rem 0;border-bottom:1px solid color-mix(in srgb,var(--foreground) 12%,transparent)}.cover-wrap{position:relative;isolation:isolate;overflow:visible;padding-right:10px;background:repeating-linear-gradient(to bottom,#e8e4d9 0,#e8e4d9 1px,#c9c4b8 1px,#c9c4b8 2px);box-shadow:7px 16px 30px color-mix(in srgb,var(--foreground) 14%,transparent);transition:transform .3s ease,box-shadow .3s ease}.cover-wrap::before{content:"";position:absolute;z-index:2;left:0;top:0;bottom:0;width:11px;border-radius:.1rem 0 0 .1rem;background:linear-gradient(90deg,rgba(0,0,0,.28),rgba(255,255,255,.12) 35%,rgba(0,0,0,.08));pointer-events:none}.books img{position:relative;z-index:1;display:block;width:100%;aspect-ratio:2/3;object-fit:cover;transition:transform .6s cubic-bezier(.2,.7,.2,1);backface-visibility:hidden}.books img.cover-crop{transform:scale(1.025)}.books article:hover img.cover-crop{transform:scale(1.05)}.books article:hover img{transform:scale(1.025)}.books article:hover .cover-wrap{transform:translateY(-4px);box-shadow:10px 21px 36px color-mix(in srgb,var(--foreground) 17%,transparent)}@media(prefers-reduced-motion:reduce){.cover-wrap,.books img{transition:none!important}.books article:hover .cover-wrap{transform:none}}.book-copy{max-width:650px}.book-number{margin:0 0 .8rem;color:var(--muted);font-size:.68rem;font-weight:650;letter-spacing:.12em;text-transform:uppercase}.books h2{margin:0;font-size:clamp(2.2rem,4.5vw,4rem);line-height:1;letter-spacing:-.045em}.subtitle{margin:.8rem 0 0;color:var(--muted);font-size:1.05rem}.description{max-width:620px;margin:2rem 0 0;color:var(--muted);line-height:1.75}.actions{display:flex;gap:1.75rem;flex-wrap:wrap;margin-top:2rem}.actions a{color:inherit;text-underline-offset:.3em}.actions span{display:inline-block;margin-left:.2rem;transition:transform .2s ease}.actions a:hover span{transform:translateX(3px)}@media(max-width:800px){main{width:min(100% - 2rem,1080px)}.page-head{padding:6rem 0 4rem}.books article{grid-template-columns:220px 1fr;gap:3rem;padding:4rem 0}}@media(max-width:600px){.page-head{padding:5rem 0 3.5rem}.books article{grid-template-columns:1fr;gap:2rem;padding:3.5rem 0}.cover-wrap{max-width:280px}.book-copy{max-width:none}.description{margin-top:1.5rem}}
</style>
