---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="About — V.T.R. Ravi Kumar" description="About V.T.R. Ravi Kumar."><main><header><p class="label">About</p><h1>Engineer. Author. Photographer. Traveller.</h1></header><section><p>I spent much of my career building software. These days I spend my time writing, building projects, travelling, riding and taking photographs.</p><p>vtrrk.in is a home for those interests — a simple place to see what I'm working on, what I've written and where the road has taken me.</p></section></main></BaseLayout>
<style>main{width:min(850px,calc(100% - 3rem));margin:0 auto}header{padding:8rem 0 5rem}h1{margin:0;font-size:clamp(3rem,7vw,6rem);line-height:.98;letter-spacing:-.05em}.label{color:var(--muted);font-size:.78rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase}section{border-top:1px solid color-mix(in srgb,var(--foreground) 15%,transparent);padding:4rem 0;font-size:1.25rem;line-height:1.8;color:var(--muted)}section p{max-width:700px}@media(max-width:600px){main{width:min(100% - 2rem,850px)}header{padding:5rem 0 3rem}}
</style>
