---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../content/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<BaseLayout
  title={`${project.title} — Projects — V.T.R. Ravi Kumar`}
  description={project.description}
>
  <main>
    <a class="back" href="/projects/">← Projects</a>

    <header>
      <p class="label">Project</p>
      <h1>{project.title}</h1>
      <p class="description">{project.description}</p>
      <p class="status">{project.status}</p>
    </header>

    <section>
      <h2>What is it?</h2>
      <p>{project.description}</p>

      <h2>Why?</h2>
      <p>{project.why}</p>

      {project.links?.length && (
        <>
          <h2>Links</h2>
          <ul>
            {project.links.map((link) => (
              <li><a href={link.url}>{link.label} →</a></li>
            ))}
          </ul>
        </>
      )}
    </section>
  </main>
</BaseLayout>

<style>
main{width:min(1000px,calc(100% - 3rem));margin:0 auto;padding-bottom:7rem}.back{display:inline-block;margin:2rem 0 1.5rem;color:var(--muted);font-size:.9rem;text-decoration:none}.back:hover{color:var(--foreground)}header{max-width:780px;padding:3rem 0 5rem}.label{margin:0 0 .8rem;color:var(--muted);font-size:.75rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase}h1{margin:0 0 1.25rem;font-size:clamp(3rem,7vw,5.4rem);line-height:.96;letter-spacing:-.045em}.description{max-width:700px;margin:0;color:var(--muted);font-size:1.18rem;line-height:1.7}.status{margin-top:1.5rem;color:var(--muted);font-size:.8rem}section{max-width:720px;margin:0 auto}h2{margin:3.5rem 0 1rem;font-size:2rem;line-height:1.15;letter-spacing:-.02em}section p{margin:0 0 1.4rem;font-size:1.08rem;line-height:1.85}ul{padding-left:1.25rem;line-height:1.8}a{text-underline-offset:.2em}@media(max-width:600px){main{width:min(100% - 2rem,1000px);padding-bottom:5rem}.back{margin:1.5rem 0 1rem}header{padding:2.5rem 0 3rem}h1{font-size:clamp(2.6rem,13vw,4rem)}.description{font-size:1.05rem;line-height:1.65}section{max-width:none}h2{margin-top:2.75rem;font-size:1.7rem}section p{font-size:1.03rem;line-height:1.8}}
</style>
