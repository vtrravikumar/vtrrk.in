---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("projects");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, status, links, heroImage } = entry.data;
---

<BaseLayout title={`${title} — Projects — V.T.R. Ravi Kumar`} description={description}>
  <main id="main-content" tabindex="-1">
    <a class="back" href="/projects/">← Projects</a>

    <article>
      {heroImage && <img class="hero-image" src={heroImage} alt="" />}

      <header>
        <p class="label">Project</p>
        <h1>{title}</h1>
        <p class="description">{description}</p>
        {status && <p class="status">{status}</p>}
      </header>

      <section class="content">
        <Content />
      </section>

      {links?.length && (
        <nav class="links" aria-label="Project links">
          <h2>Links</h2>
          <ul>
            {links.map((link) => (
              <li><a href={link.url}>{link.label} →</a></li>
            ))}
          </ul>
        </nav>
      )}
    </article>
  </main>
</BaseLayout>

<style>
main{width:min(760px,calc(100% - 3rem));margin:0 auto}.back{display:inline-block;margin:3rem 0 5rem;color:var(--muted);text-underline-offset:.3em}article{padding-bottom:6rem}.hero-image{display:block;width:100%;margin-bottom:3rem}.label{margin:0 0 1rem;color:var(--muted);font-size:.78rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase}h1{margin:0;font-size:clamp(3rem,8vw,5.5rem);line-height:.95;letter-spacing:-.05em}.description{max-width:680px;margin:1.5rem 0 0;color:var(--muted);font-size:1.25rem;line-height:1.6}.status{display:inline-block;margin:1.5rem 0 0;padding:.4rem .7rem;border:1px solid color-mix(in srgb,var(--foreground) 15%,transparent);color:var(--muted);font-size:.78rem}.content{margin-top:5rem;font-size:1.08rem;line-height:1.8}.content :global(h2){margin:3rem 0 1rem;font-size:1.6rem;line-height:1.2;letter-spacing:-.02em}.content :global(p){margin:1.2rem 0}.links{margin-top:4rem;padding-top:2rem;border-top:1px solid color-mix(in srgb,var(--foreground) 14%,transparent)}.links h2{margin:0 0 1rem;font-size:1rem}.links ul{margin:0;padding:0;list-style:none}.links li+li{margin-top:.6rem}.links a{text-underline-offset:.3em;color:inherit}@media(max-width:650px){main{width:min(100% - 2rem,760px)}.back{margin:2rem 0 4rem}.content{margin-top:4rem;font-size:1rem}}
</style>
