---
import BaseLayout from "../layouts/BaseLayout.astro";
import { now } from "../content/site";
import { books } from "../content/books";
import { projects } from "../content/projects";
import { writing } from "../content/writing";

const destinations = [
  { label: "Now", description: now.intro, href: "/now/", glyph: "01" },
  { label: "Books", description: "Four books, four different journeys.", href: "/books/", glyph: "02" },
  { label: "Writing", description: "Ideas, observations and stories.", href: "/writing/", glyph: "03" },
  { label: "Projects", description: "Things I'm building.", href: "/projects/", glyph: "04" },
  { label: "Travel", description: "Twenty years on the road.", href: "/travel/", glyph: "05" },
  { label: "Photography", description: "Photographs from the road and beyond.", href: "/photography/", glyph: "06" },
];
---

<BaseLayout title="V.T.R. Ravi Kumar — Engineer · Author · Photographer · Traveller" description="The personal website of V.T.R. Ravi Kumar — engineer, author, photographer and traveller.">
  <main id="main-content" tabindex="-1">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Engineer · Author · Photographer · Traveller</p>
        <h1><span>V.T.R.</span><strong>Ravi Kumar</strong></h1>
        <p class="intro">I spent 25 years building software.<br />Now I'm building things that interest me.</p>
        <a class="primary-action" href="#explore">Explore <span>→</span></a>
      </div>
      <aside class="hero-note">
        <span class="note-line"></span>
        <p>{now.intro}</p>
        <a href="/now/">What I'm working on <span>↗</span></a>
      </aside>
    </section>

    <section class="explore" id="explore" aria-labelledby="explore-title">
      <div class="section-heading">
        <p class="section-kicker">Explore</p>
        <h2 id="explore-title">Follow your curiosity.</h2>
      </div>
      <div class="destination-grid">
        {destinations.map((item) => (
          <a class="destination" href={item.href}>
            <span class="destination-number">{item.glyph}</span>
            <div>
              <h3>{item.label}</h3>
              <p>{item.description}</p>
            </div>
            <span class="destination-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="featured" aria-labelledby="featured-title">
      <div class="section-heading featured-heading">
        <div>
          <p class="section-kicker">Featured</p>
          <h2 id="featured-title">Books that came from real life.</h2>
        </div>
        <a class="section-link" href="/books/">View all books <span>→</span></a>
      </div>

      <div class="book-grid">
        {books.map((book) => (
          <a class="book-card" href={`/books/${book.slug}/`}>
            <div class="book-cover"><img class={book.slug === "the-white-envelope" ? "cover-crop" : undefined} src={book.cover} alt={`Cover of ${book.title}`} loading="lazy" /></div>
            <div class="book-meta">
              <h3>{book.title}</h3>
              {book.subtitle && <p>{book.subtitle}</p>}
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="closing-note" aria-label="A common thread">
      <span class="note-line"></span>
      <p>Different journeys.<br />A common thread — curiosity.</p>
    </section>

    <section class="now-strip" aria-label="What I'm doing now">
      <div>
        <p class="section-kicker">01 · Now</p>
        <h2>{now.title}</h2>
      </div>
      <div class="now-items">
        {now.items.slice(0, 3).map((item) => <article><h3>{item.title}</h3><p>{item.description}</p></article>)}
      </div>
      <a class="section-link" href="/now/">See what I'm doing <span>→</span></a>
    </section>
  </main>
</BaseLayout>

<style>
main{width:min(1180px,calc(100% - 3rem));margin:0 auto;padding-bottom:6rem}.hero{min-height:72vh;display:grid;grid-template-columns:minmax(0,1.6fr) minmax(220px,.55fr);align-items:center;gap:5rem;padding:5rem 1rem 4rem;position:relative;overflow:hidden}.hero::before{content:"";position:absolute;width:22rem;height:22rem;right:8%;top:12%;border-radius:50%;background:radial-gradient(circle,var(--accent-soft),transparent 68%);filter:blur(8px);pointer-events:none}.hero-copy,.hero-note{position:relative;z-index:1}.eyebrow,.section-kicker{margin:0 0 1rem;font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}h1{margin:0;font-size:clamp(4.2rem,10vw,8.5rem)!important;line-height:.86;letter-spacing:-.075em;display:flex;flex-direction:column}h1 span{color:var(--foreground)}h1 strong{font-weight:700;background:linear-gradient(100deg,var(--foreground) 12%,var(--muted) 72%);-webkit-background-clip:text;background-clip:text;color:transparent}.intro{max-width:680px;margin:2.25rem 0 0;font-size:clamp(1.2rem,2.3vw,1.75rem);line-height:1.42;letter-spacing:-.02em;color:var(--foreground)}.primary-action{display:inline-flex;align-items:center;gap:1rem;margin-top:2.2rem;padding:.8rem 1.2rem;border:1px solid var(--border);border-radius:999px;background:var(--foreground);color:var(--background);font-size:.9rem;font-weight:650;text-decoration:none;box-shadow:0 10px 30px rgba(0,0,0,.12)}.primary-action:hover{color:var(--background);transform:translateY(-1px);box-shadow:0 14px 34px rgba(0,0,0,.16)}.primary-action span{font-size:1.1rem}.hero-note{align-self:center;max-width:260px;margin-top:4rem}.note-line{display:block;width:1px;height:4rem;margin-bottom:1.2rem;background:linear-gradient(var(--accent),var(--accent-creative))}.hero-note p,.closing-note p{margin:0;color:var(--muted);font-size:1rem;line-height:1.65;font-style:italic}.hero-note a{display:inline-block;margin-top:1.2rem;font-size:.78rem;text-decoration:none}.hero-note a span,.section-link span{margin-left:.35rem}.explore,.featured,.now-strip{border-top:1px solid var(--border);padding:4.5rem 1rem}.section-heading h2{margin:0;max-width:620px;font-size:clamp(2rem,4.5vw,3.5rem);letter-spacing:-.055em}.destination-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:2.5rem}.destination{min-height:190px;padding:1.25rem;display:flex;flex-direction:column;justify-content:space-between;gap:1rem;border:1px solid var(--border);border-radius:1.5rem;background:linear-gradient(145deg,var(--surface-elevated),var(--surface));box-shadow:var(--glass-shadow);backdrop-filter:blur(20px) saturate(140%);-webkit-backdrop-filter:blur(20px) saturate(140%);color:inherit;text-decoration:none;transition:transform .3s cubic-bezier(.2,.7,.2,1),border-color .3s ease,background .3s ease}.destination:hover{color:inherit;transform:translateY(-4px);border-color:color-mix(in srgb,var(--accent) 45%,var(--border));background:linear-gradient(145deg,var(--accent-soft),var(--surface))}.destination-number{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.68rem;color:var(--accent)}.destination h3{margin:0;font-size:1.25rem;letter-spacing:-.025em}.destination p{margin:.5rem 0 0;max-width:250px;color:var(--muted);font-size:.82rem;line-height:1.5}.destination-arrow{align-self:flex-end;width:2rem;height:2rem;display:grid;place-items:center;border:1px solid var(--border);border-radius:50%;color:var(--foreground);font-size:.9rem;transition:background .25s ease,color .25s ease}.destination:hover .destination-arrow{background:var(--accent);color:white;border-color:var(--accent)}.featured-heading{display:flex;align-items:end;justify-content:space-between;gap:2rem}.section-link{white-space:nowrap;color:var(--accent);font-size:.82rem;text-decoration:none}.book-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.25rem;margin-top:2.5rem}.book-card{color:inherit;text-decoration:none}.book-cover{position:relative;isolation:isolate;overflow:visible;padding-right:9px;border-radius:.65rem 0 0 .65rem;background:repeating-linear-gradient(to bottom,#e8e4d9 0,#e8e4d9 1px,#c9c4b8 1px,#c9c4b8 2px);box-shadow:7px 13px 24px rgba(0,0,0,.14);transition:transform .3s ease,box-shadow .3s ease;border-radius:0}.book-cover::before{content:"";position:absolute;z-index:2;left:0;top:0;bottom:0;width:10px;border-radius:0;background:linear-gradient(90deg,rgba(0,0,0,.28),rgba(255,255,255,.12) 35%,rgba(0,0,0,.08));pointer-events:none}.book-card:hover{color:inherit}.book-card:hover .book-cover{transform:translateY(-4px);box-shadow:10px 19px 30px rgba(0,0,0,.17)}.book-card img{position:relative;z-index:1;display:block;width:100%;aspect-ratio:2/3;object-fit:cover;border-radius:0;backface-visibility:hidden}.book-card img.cover-crop{transform:scale(1.055)}@media(prefers-reduced-motion:reduce){.book-cover,.book-card img{transition:none!important}.book-card:hover .book-cover{transform:none}}.book-meta h3{margin:.9rem 0 0;font-size:1rem;letter-spacing:-.02em}.book-meta p{margin:.25rem 0 0;color:var(--muted);font-size:.75rem;line-height:1.45}.closing-note{display:flex;justify-content:flex-end;gap:1.2rem;padding:1rem 8% 5rem}.closing-note .note-line{height:4.5rem;background:var(--accent-creative)}.now-strip{display:grid;grid-template-columns:.8fr 1.6fr auto;align-items:end;gap:3rem}.now-strip h2{margin:0;font-size:clamp(1.7rem,3vw,2.4rem)}.now-items{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}.now-items article{padding-top:1rem;border-top:1px solid var(--border)}.now-items h3{margin:0;font-size:.9rem}.now-items p{margin:.45rem 0 0;color:var(--muted);font-size:.78rem;line-height:1.5}@media(max-width:850px){main{width:min(100% - 1.5rem,1180px)}.hero{min-height:auto;grid-template-columns:1fr;gap:2.5rem;padding:4rem .5rem 5rem}.hero-note{margin-top:0;max-width:420px}.destination-grid{grid-template-columns:repeat(2,1fr)}.book-grid{grid-template-columns:repeat(2,1fr)}.now-strip{grid-template-columns:1fr}.now-items{grid-template-columns:1fr}.closing-note{padding-right:2rem}}@media(max-width:520px){.hero{padding-top:3rem}.eyebrow{font-size:.62rem}.hero h1{font-size:clamp(3.5rem,18vw,5.5rem)!important}.intro{font-size:1.15rem}.explore,.featured,.now-strip{padding:3.25rem .5rem}.destination-grid{grid-template-columns:1fr}.destination{min-height:160px}.featured-heading{align-items:flex-start;flex-direction:column;gap:1rem}.book-grid{gap:.8rem}.book-meta h3{font-size:.9rem}.closing-note{justify-content:flex-start;padding-left:2rem}.hero-note p{font-size:.92rem}}
</style>
