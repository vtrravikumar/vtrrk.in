---
import BaseLayout from "../layouts/BaseLayout.astro";
import { now } from "../content/site";
import { books } from "../content/books";
---

<BaseLayout
	title="V.T.R. Ravi Kumar — Engineer · Author · Photographer · Traveller"
	description="The personal website of V.T.R. Ravi Kumar — engineer, author, photographer and traveller."
>
	<main>
		<section class="hero">
			<p class="eyebrow">Engineer · Author · Photographer · Traveller</p>

			<h1>V.T.R. Ravi Kumar</h1>

			<p class="intro">
				I spent 25 years building software. Now I'm building things that
				interest me.
			</p>

			<div class="hero-links">
				<a href="#books">Books</a>
				<a href="#projects">Projects</a>
				<a href="#writing">Writing</a>
			</div>
		</section>

		<section class="content-section" id="now">
	<p class="section-label">Now</p>

	<h2>{now.title}</h2>

	<p class="section-intro">
		{now.intro}
	</p>

	<div class="now-grid">
		{now.items.map((item) => (
			<article>
				<h3>{item.title}</h3>
				<p>{item.description}</p>
			</article>
		))}
	</div>
</section>

		<section class="content-section books-section" id="books">
	<p class="section-label">Books</p>

	<h2>Stories, ideas and experiences in print.</h2>

	<div class="books-list">
		{books.map((book) => (
			<article class="book">
				<div class="book-cover">
					{book.cover ? (
						<img src={book.cover} alt={`Cover of ${book.title}`} />
					) : (
						<span>Cover<br />coming soon</span>
					)}
				</div>

				<div class="book-info">
					<h3>{book.title}</h3>

					{book.subtitle && <p class="book-subtitle">{book.subtitle}</p>}

					{book.description && <p>{book.description}</p>}

					{book.href && (
						<a href={book.href}>Explore book →</a>
					)}
				</div>
			</article>
		))}
	</div>
</section>

		<section class="placeholder" id="projects">
			<p class="section-label">Projects</p>
			<h2>Things I'm building.</h2>
		</section>

		<section class="placeholder" id="writing">
			<p class="section-label">Writing</p>
			<h2>Thoughts, observations and stories.</h2>
		</section>
	</main>
</BaseLayout>

<style>
	main {
		width: min(1200px, calc(100% - 3rem));
		margin: 0 auto;
	}

	.hero {
		min-height: 75vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		max-width: 850px;
		padding: 5rem 0;
	}

	.eyebrow,
	.section-label {
		margin: 0 0 1.5rem;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
	}

	h1 {
		margin: 0;
		font-size: clamp(3.5rem, 9vw, 7rem);
		line-height: 0.95;
		letter-spacing: -0.05em;
		font-weight: 700;
	}

	.intro {
		max-width: 620px;
		margin: 2.5rem 0 0;
		font-size: clamp(1.3rem, 2.5vw, 2rem);
		line-height: 1.45;
		color: var(--muted);
	}

	.hero-links {
		display: flex;
		gap: 1.5rem;
		margin-top: 3rem;
	}

	.hero-links a {
		font-size: 0.95rem;
		text-underline-offset: 0.3em;
	}

	.placeholder {
		padding: 8rem 0;
		border-top: 1px solid color-mix(in srgb, var(--foreground) 15%, transparent);
	}

	.placeholder h2 {
		margin: 0;
		font-size: clamp(2rem, 5vw, 4rem);
		line-height: 1.05;
		letter-spacing: -0.03em;
		font-weight: 600;
	}

	.placeholder > p:last-child {
		max-width: 600px;
		margin-top: 1.5rem;
		font-size: 1.2rem;
		line-height: 1.6;
		color: var(--muted);
	}

	@media (max-width: 600px) {
		main {
			width: min(100% - 2rem, 1200px);
		}

		.hero {
			min-height: 70vh;
			padding: 4rem 0;
		}

		.hero-links {
			flex-wrap: wrap;
		}

		.placeholder {
			padding: 5rem 0;
		}
	}
	.content-section {
	padding: 8rem 0;
	border-top: 1px solid color-mix(in srgb, var(--foreground) 15%, transparent);
}

.content-section h2 {
	margin: 0;
	font-size: clamp(2.5rem, 6vw, 5rem);
	line-height: 1;
	letter-spacing: -0.04em;
	font-weight: 600;
}

.section-intro {
	max-width: 650px;
	margin: 1.5rem 0 0;
	font-size: 1.2rem;
	line-height: 1.6;
	color: var(--muted);
}

.now-grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 3rem;
	margin-top: 4rem;
}

.now-grid article h3 {
	margin: 0;
	font-size: 1.1rem;
}

.now-grid article p {
	margin: 0.75rem 0 0;
	line-height: 1.6;
	color: var(--muted);
}

@media (max-width: 700px) {
	.now-grid {
		grid-template-columns: 1fr;
		gap: 2.5rem;
	}
}

.books-list {
	display: flex;
	flex-direction: column;
	gap: 4rem;
	margin-top: 5rem;
}

.book {
	display: grid;
	grid-template-columns: 220px 1fr;
	gap: 4rem;
	align-items: start;
	max-width: 900px;
}

.book-cover {
	width: 220px;
	aspect-ratio: 2 / 3;
	display: flex;
	align-items: center;
	justify-content: center;
	background: color-mix(in srgb, var(--foreground) 7%, var(--background));
	color: var(--muted);
	text-align: center;
	font-size: 0.8rem;
	line-height: 1.4;
}

.book-cover img {
	display: block;
	width: 100%;
	height: 100%;
	object-fit: cover;
}

.book-info {
	padding-top: 0.5rem;
}

.book-info h3 {
	margin: 0;
	font-size: clamp(2rem, 4vw, 3.5rem);
	line-height: 1;
	letter-spacing: -0.035em;
}

.book-subtitle {
	margin: 0.75rem 0 0;
	font-size: 1.15rem;
	color: var(--muted);
}

.book-info > p:not(.book-subtitle) {
	max-width: 600px;
	margin: 1.5rem 0 0;
	line-height: 1.7;
	color: var(--muted);
}

.book-info a {
	display: inline-block;
	margin-top: 1.5rem;
	text-underline-offset: 0.3em;
}

@media (max-width: 650px) {
	.book {
		grid-template-columns: 140px 1fr;
		gap: 1.5rem;
	}

	.book-cover {
		width: 140px;
	}

	.book-info h3 {
		font-size: 1.8rem;
	}
}
</style>