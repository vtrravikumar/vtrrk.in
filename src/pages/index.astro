---
import BaseLayout from "../layouts/BaseLayout.astro";
import { now } from "../content/site";
import { books } from "../content/books";
import { projects } from "../content/projects";
import { writing } from "../content/writing";
---

<BaseLayout title="V.T.R. Ravi Kumar — Engineer · Author · Photographer · Traveller" description="The personal website of V.T.R. Ravi Kumar — engineer, author, photographer and traveller.">
  <main>
    <section class="hero">
      <p class="eyebrow">Engineer · Author · Photographer · Traveller</p>
      <h1>V.T.R. Ravi Kumar</h1>
      <p class="intro">I spent 25 years building software. Now I'm building things that interest me.</p>
      <div class="links"><a href="/about/">About</a><a href="/now/">Now</a><a href="/books/">Books</a><a href="/travel/">Travel</a></div>
    </section>

    <section class="section now-section">
      <div class="section-head"><p class="label">Now</p><a href="/now/">See what I'm doing →</a></div>
      <h2>{now.title}</h2><p class="muted">{now.intro}</p>
      <div class="grid three">{now.items.map((item) => <article><h3>{item.title}</h3><p>{item.description}</p></article>)}</div>
    </section>

    <section class="section books-section">
      <div class="section-head"><p class="label">Books</p><a href="/books/">All books →</a></div>
      <h2>Three books, three different journeys.</h2>
      <div class="book-grid">{books.map((book) => <a class="book-card" href={`/books/${book.slug}/`}><div class="book-cover"><img src={book.cover} alt={`Cover of ${book.title}`} loading="lazy" /></div><h3>{book.title}</h3>{book.subtitle && <p>{book.subtitle}</p>}</a>)}</div>
    </section>

    <section class="section">
      <div class="section-head"><p class="label">Projects</p><a href="/projects/">All projects →</a></div>
      <h2>Things I'm building.</h2>
      <div class="list">{projects.map((project) => <article><div><h3>{project.title}</h3><p>{project.description}</p></div><span>{project.status}</span></article>)}</div>
    </section>

    <section class="section split">
      <div><p class="label">Writing</p><h2>Ideas, observations and stories.</h2><a href="/writing/">Explore writing →</a></div>
      <div class="compact-list">{writing.map((entry) => <article><span>{entry.type}</span><h3>{entry.title}</h3><p>{entry.description}</p></article>)}</div>
    </section>

    <section class="gateway">
      <div><p class="label">Travel</p><h2>Twenty years on the road.</h2><p class="muted">Detailed journeys, places, lessons, mistakes and stories — organised by continent and country.</p></div>
      <div class="gateway-links"><a href="/travel/">Explore Travel <span>→</span></a><a href="/photography/">Photography <span>→</span></a></div>
    </section>
  </main>
</BaseLayout>

<style>
main{width:min(1100px,calc(100% - 3rem));margin:0 auto}.hero{min-height:72vh;display:flex;flex-direction:column;justify-content:center;max-width:900px;padding:5rem 0}.eyebrow,.label{margin:0 0 1rem;font-size:.78rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}h1{margin:0;font-size:clamp(3.5rem,9vw,7rem);line-height:.94;letter-spacing:-.055em}.intro{max-width:650px;margin:2rem 0 0;font-size:clamp(1.3rem,2.5vw,2rem);line-height:1.45;color:var(--muted)}.links{display:flex;gap:1.75rem;margin-top:2.75rem}.links a,.section-head a,.gateway a{text-underline-offset:.3em}.links a{transition:opacity .2s ease}.links:hover a:not(:hover){opacity:.45}.section{padding:7rem 0;border-top:1px solid color-mix(in srgb,var(--foreground) 12%,transparent)}.section-head{display:flex;justify-content:space-between;align-items:baseline;gap:1rem}.section-head .label{margin:0}.section-head a{color:var(--muted);font-size:.88rem}.section-head a:hover{color:var(--foreground)}.section h2,.gateway h2{max-width:850px;margin:0;font-size:clamp(2.4rem,6vw,5rem);line-height:1;letter-spacing:-.04em}.muted{max-width:650px;color:var(--muted);line-height:1.65}.grid{display:grid;gap:2.5rem;margin-top:3.5rem}.three{grid-template-columns:repeat(3,1fr)}.grid article{padding-top:1.5rem;border-top:1px solid color-mix(in srgb,var(--foreground) 10%,transparent)}.grid h3,.list h3,.compact-list h3{margin:0;font-size:1.15rem}.grid p,.list p,.compact-list p{margin:.7rem 0 0;color:var(--muted);line-height:1.6}.book-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2.5rem;margin-top:3.5rem}.book-card{color:inherit;text-decoration:none}.book-cover{overflow:hidden;background:color-mix(in srgb,var(--foreground) 4%,var(--background))}.book-card img{display:block;width:100%;aspect-ratio:2/3;object-fit:cover;transition:transform .5s cubic-bezier(.2,.7,.2,1)}.book-card:hover img{transform:scale(1.025)}.book-card h3{margin:1.15rem 0 0;font-size:1.3rem;letter-spacing:-.02em}.book-card p{margin:.4rem 0 0;color:var(--muted);font-size:.9rem;line-height:1.5}.list{margin-top:3rem;border-top:1px solid color-mix(in srgb,var(--foreground) 12%,transparent)}.list article{display:flex;justify-content:space-between;gap:2rem;padding:2rem 0;border-bottom:1px solid color-mix(in srgb,var(--foreground) 12%,transparent)}.list article p{max-width:700px}.list span,.compact-list span{font-size:.75rem;color:var(--muted);white-space:nowrap}.split{display:grid;grid-template-columns:1fr 1fr;gap:5rem}.split h2{margin-bottom:2rem}.compact-list{border-top:1px solid color-mix(in srgb,var(--foreground) 12%,transparent)}.compact-list article{padding:1.5rem 0;border-bottom:1px solid color-mix(in srgb,var(--foreground) 12%,transparent)}.compact-list h3{margin-top:.35rem}.gateway{padding:8rem 0;display:grid;grid-template-columns:1fr auto;gap:3rem;align-items:end;border-top:1px solid color-mix(in srgb,var(--foreground) 12%,transparent)}.gateway-links{display:flex;flex-direction:column;gap:1rem}.gateway-links a{color:inherit;text-decoration:none}.gateway-links span{display:inline-block;margin-left:.25rem;transition:transform .2s ease}.gateway-links a:hover{text-decoration:underline}.gateway-links a:hover span{transform:translateX(4px)}@media(max-width:700px){main{width:min(100% - 2rem,1100px)}.hero{min-height:65vh;padding:4rem 0}.three,.book-grid,.split,.gateway{grid-template-columns:1fr}.book-grid{gap:2.75rem}.list article{display:block}.list span{display:block;margin-top:1rem}.gateway-links{margin-top:1rem}.section{padding:5rem 0}}@media(max-width:430px){.hero{padding:3.5rem 0}.hero h1{font-size:clamp(3rem,14vw,4.5rem)}.intro{font-size:1.15rem}}
</style>
