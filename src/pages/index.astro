---
import BaseLayout from "../layouts/BaseLayout.astro";
import { now } from "../content/site";
import { books } from "../content/books";
import { projects } from "../content/projects";
import { writing } from "../content/writing";
---

<BaseLayout title="V.T.R. Ravi Kumar — Engineer · Author · Photographer · Traveller" description="The personal website of V.T.R. Ravi Kumar — engineer, author, photographer and traveller.">
  <main>
    <section class="hero">
      <p class="eyebrow">Engineer · Author · Photographer · Traveller</p>
      <h1>V.T.R. Ravi Kumar</h1>
      <p class="intro">I spent 25 years building software. Now I'm building things that interest me.</p>
      <p class="hint">Explore only what interests you.</p>
    </section>

    <section class="explorer" aria-label="Explore the site">
      <details>
        <summary><span><b>Now</b><small>{now.intro}</small></span><em>+</em></summary>
        <div class="detail-content">
          <div class="grid three">{now.items.map((item) => <article><h3>{item.title}</h3><p>{item.description}</p></article>)}</div>
          <a class="more" href="/now/">See what I'm doing →</a>
        </div>
      </details>

      <details>
        <summary><span><b>Books</b><small>Four books, four different journeys.</small></span><em>+</em></summary>
        <div class="detail-content">
          <div class="book-grid">{books.map((book) => <a class="book-card" href={`/books/${book.slug}/`}><div class="book-cover"><img src={book.cover} alt={`Cover of ${book.title}`} loading="lazy" /></div><h3>{book.title}</h3>{book.subtitle && <p>{book.subtitle}</p>}</a>)}</div>
          <a class="more" href="/books/">Explore all books →</a>
        </div>
      </details>

      <details>
        <summary><span><b>Writing</b><small>Ideas, observations and stories.</small></span><em>+</em></summary>
        <div class="detail-content">
          <div class="compact-list">{writing.map((entry) => <article><span>{entry.type}</span><h3>{entry.title}</h3><p>{entry.description}</p></article>)}</div>
          <a class="more" href="/writing/">Explore writing →</a>
        </div>
      </details>

      <details>
        <summary><span><b>Projects</b><small>Things I'm building.</small></span><em>+</em></summary>
        <div class="detail-content">
          <div class="list">{projects.map((project) => <article><div><h3>{project.title}</h3><p>{project.description}</p></div><span>{project.status}</span></article>)}</div>
          <a class="more" href="/projects/">Explore projects →</a>
        </div>
      </details>

      <details>
        <summary><span><b>Travel</b><small>Twenty years on the road.</small></span><em>+</em></summary>
        <div class="detail-content travel-preview">
          <p>Detailed journeys, places, lessons, mistakes and stories — organised by continent and country.</p>
          <a class="more" href="/travel/">Explore Travel →</a>
        </div>
      </details>

      <details>
        <summary><span><b>Photography</b><small>Photographs from the road and beyond.</small></span><em>+</em></summary>
        <div class="detail-content travel-preview">
          <p>A lightweight gateway to my photography elsewhere.</p>
          <a class="more" href="/photography/">Explore Photography →</a>
        </div>
      </details>
    </section>
  </main>
</BaseLayout>

<style>
main{width:min(1000px,calc(100% - 3rem));margin:0 auto}.hero{min-height:52vh;display:flex;flex-direction:column;justify-content:center;max-width:900px;padding:3rem 0}.eyebrow{margin:0 0 1rem;font-size:.78rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--accent)}h1{margin:0;font-size:clamp(3.5rem,9vw,7rem);line-height:.94;letter-spacing:-.055em}.intro{max-width:650px;margin:2rem 0 0;font-size:clamp(1.3rem,2.5vw,2rem);line-height:1.45;color:var(--foreground)}.hint{margin:2.5rem 0 0;font-size:.85rem;color:var(--muted)}.explorer{border-top:1px solid var(--border);padding-bottom:5rem}details{border-bottom:1px solid var(--border);transition:background .2s ease}details[open]{background:var(--surface)}summary{display:flex;justify-content:space-between;align-items:center;gap:2rem;padding:1.75rem 1rem;cursor:pointer;list-style:none}summary::-webkit-details-marker{display:none}summary span{display:flex;align-items:baseline;gap:1.5rem}summary b{font-size:1.35rem;letter-spacing:-.02em}summary small{font-size:.9rem;color:var(--muted)}summary em{font-style:normal;font-size:1.5rem;font-weight:300;color:var(--accent);transition:transform .2s ease,color .2s ease}details[open] summary em{transform:rotate(45deg);color:var(--accent-creative)}.detail-content{padding:0 1rem 2.5rem}.grid{display:grid;gap:2.5rem}.three{grid-template-columns:repeat(3,1fr)}.grid article{padding-top:1.25rem;border-top:1px solid var(--border)}.grid h3,.list h3,.compact-list h3{margin:0;font-size:1.05rem}.grid p,.list p,.compact-list p{margin:.65rem 0 0;color:var(--muted);line-height:1.6}.book-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem}.book-card{color:inherit;text-decoration:none}.book-cover{overflow:hidden;background:var(--surface-elevated);border:1px solid var(--border)}.book-card img{display:block;width:100%;aspect-ratio:2/3;object-fit:cover;transition:transform .5s cubic-bezier(.2,.7,.2,1)}.book-card:hover img{transform:scale(1.025)}.book-card h3{margin:.9rem 0 0;font-size:1.05rem}.book-card p{margin:.3rem 0 0;color:var(--muted);font-size:.82rem;line-height:1.5}.list{border-top:1px solid var(--border)}.list article{display:flex;justify-content:space-between;gap:2rem;padding:1.5rem 0;border-bottom:1px solid var(--border)}.list article p{max-width:700px}.list span,.compact-list span{font-size:.75rem;color:var(--accent);white-space:nowrap}.compact-list{border-top:1px solid var(--border)}.compact-list article{padding:1.25rem 0;border-bottom:1px solid var(--border)}.compact-list h3{margin-top:.3rem}.more{display:inline-block;margin-top:1.75rem;color:var(--accent);text-underline-offset:.3em;font-size:.9rem}.more:hover{color:var(--accent-creative)}.travel-preview p{max-width:650px;margin:0;color:var(--muted);line-height:1.65}@media(max-width:700px){main{width:min(100% - 2rem,1000px)}.hero{min-height:55vh;padding:3rem 0}.hero h1{font-size:clamp(3rem,14vw,5rem)}summary{padding:1.4rem 1rem}summary span{display:block}summary small{display:block;margin-top:.35rem}.three,.book-grid{grid-template-columns:1fr}.book-grid{grid-template-columns:repeat(2,1fr);gap:1.5rem}.list article{display:block}.list span{display:block;margin-top:.75rem}.detail-content{padding-bottom:2rem}}@media(max-width:430px){.hero{padding:2.5rem 0}.intro{font-size:1.15rem}.book-grid{grid-template-columns:1fr 1fr}}
</style>
