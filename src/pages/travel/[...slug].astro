---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { load } from "js-yaml";

type Visit = {
  from?: string | Date;
  to?: string | Date;
  travelling_with?: string[];
};

type TravelData = {
  title?: string;
  country?: string;
  continent?: string;
  region?: string;
  from?: string | Date;
  to?: string | Date;
  duration_days?: number;
  travelled_with?: string[];
  travel_type?: string;
  solo?: boolean;
  banner?: string;
  intro?: string;
  visits?: Visit[];
  featured?: boolean;
};

export function getStaticPaths() {
  const yamlModules = import.meta.glob("../../content/travel/**/*.yaml", {
    eager: true,
    query: "?raw",
    import: "default"
  });

  return Object.entries(yamlModules).map(([path, raw]) => {
    const data = load(raw as string) as TravelData;
    const relative = path.replace("../../content/travel/", "").replace(/\.yaml$/, "");
    const parts = relative.split("/");
    const slug = parts[0] === "india" ? `india/${parts[1]}` : parts[0];
    return { params: { slug }, props: { data, path } };
  });
}

const markdownModules = import.meta.glob("../../content/travel/**/*.md", { eager: true });
const { slug } = Astro.params;
const { data, path } = Astro.props as { data: TravelData; path: string };
const isIndia = slug?.startsWith("india/") ?? false;

const markdownPath = path.replace(/\.yaml$/, ".md");
const storyModule = markdownModules[markdownPath] as { Content: unknown } | undefined;
const Story = storyModule?.Content;

const title = isIndia ? (data.title ?? "Journey") : (data.country ?? "Journey");
const region = isIndia ? (data.region ?? "Journey") : (data.continent ?? "Travel");
const firstVisit = data.visits?.[0];
const from = isIndia ? data.from : firstVisit?.from;
const to = isIndia ? data.to : firstVisit?.to;
const companions = isIndia
  ? data.travelled_with ?? []
  : firstVisit?.travelling_with ?? data.travelled_with ?? [];
const companion = companions.join(", ") || (data.solo ? "Solo" : "Solo");
const visitCount = data.visits?.length ?? 1;
const journeyValue = isIndia
  ? (data.travel_type ?? "Journey")
  : `${visitCount} ${visitCount === 1 ? "visit" : "visits"}`;

const toDate = (value: unknown) => {
  if (value instanceof Date) return value;
  if (typeof value === "string") {
    const datePart = value.slice(0, 10);
    return new Date(`${datePart}T00:00:00`);
  }
  return new Date(NaN);
};

const formatDate = (value: unknown) => {
  const date = toDate(value);
  return Number.isNaN(date.getTime())
    ? "—"
    : date.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
};

const durationDays = isIndia
  ? data.duration_days
  : from && to
    ? Math.round((toDate(to).getTime() - toDate(from).getTime()) / 86400000) + 1
    : undefined;

const banner = data.banner ?? "/images/travel/default.jpg";
const backHref = isIndia ? "/travel/india/" : "/travel/";
const backLabel = isIndia ? "← India journeys" : "← Travel";
---
<BaseLayout title={`${title} — Travel — V.T.R. Ravi Kumar`} description={`A personal travelogue from ${title}${isIndia ? ", India" : ""}.`}>
  <main>
    <a class="back" href={backHref}>{backLabel}</a>

    <section class="hero">
      <img class="banner" src={banner} alt={`${title} travel banner`} />
      <div class="hero-copy">
        <p class="label">{isIndia ? "India" : region} · {isIndia ? region : title}</p>
        <h1>{title}</h1>
        <p class="intro">{data.intro ?? `A personal travelogue from ${title}.`}</p>
      </div>
    </section>

    <section class="record" aria-label="Journey details">
      {from && to && <div><span>Dates</span><strong>{formatDate(from)} – {formatDate(to)}</strong></div>}
      {durationDays !== undefined && <div><span>Duration</span><strong>{durationDays} days</strong></div>}
      <div><span>Travelled with</span><strong>{companion}</strong></div>
      <div><span>Journey</span><strong>{journeyValue}</strong></div>
    </section>

    {Story && <article class="story"><Story /></article>}
  </main>
</BaseLayout>
<style>
main{width:min(1080px,calc(100% - 3rem));margin:0 auto;padding-bottom:7rem}.back{display:inline-block;margin:2rem 0 1.5rem;color:var(--muted);font-size:.9rem;text-decoration:none;transition:color .2s ease}.back:hover{color:var(--foreground)}.hero{position:relative}.banner{display:block;width:100%;aspect-ratio:2.25/1;object-fit:cover;object-position:center;border-radius:3px}.hero-copy{max-width:780px;margin:-1px 0 0;padding:3.5rem 0 3rem}.label{margin:0 0 .8rem;color:var(--muted);font-size:.75rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase}.hero h1{margin:0 0 1.25rem;font-size:clamp(3rem,7vw,5.4rem);line-height:.96;letter-spacing:-.045em}.intro{max-width:680px;margin:0;color:var(--muted);font-size:1.18rem;line-height:1.7}.record{display:grid;grid-template-columns:repeat(4,1fr);margin-bottom:6rem;border-top:1px solid color-mix(in srgb,var(--foreground) 13%,transparent);border-bottom:1px solid color-mix(in srgb,var(--foreground) 13%,transparent)}.record div{padding:1.35rem 1rem 1.45rem 0}.record span{display:block;margin-bottom:.45rem;color:var(--muted);font-size:.7rem;text-transform:uppercase;letter-spacing:.1em}.record strong{font-size:.92rem;font-weight:500}.story{max-width:720px;margin:0 auto}.story :global(h1){display:none}.story :global(h2){margin:3.5rem 0 1rem;font-size:2rem;line-height:1.15;letter-spacing:-.02em}.story :global(h3){margin:2.5rem 0 .75rem;font-size:1.35rem}.story :global(p){margin:0 0 1.4rem;font-size:1.08rem;line-height:1.85}.story :global(ul),.story :global(ol){margin:0 0 1.5rem;padding-left:1.25rem;line-height:1.8}.story :global(blockquote){margin:2.5rem 0;padding-left:1.5rem;border-left:2px solid color-mix(in srgb,var(--foreground) 25%,transparent);color:var(--muted);font-size:1.15rem;line-height:1.7}.story :global(img){display:block;width:calc(100% + 8rem);max-width:none;margin:3rem -4rem;border-radius:3px}.story :global(figure){margin:3rem 0}.story :global(figure img){width:100%;margin:0}.story :global(figcaption){margin-top:.6rem;color:var(--muted);font-size:.78rem;line-height:1.5}@media(max-width:700px){main{width:min(100% - 2rem,1080px);padding-bottom:5rem}.back{margin:1.5rem 0 1rem}.banner{aspect-ratio:1.65/1}.hero-copy{padding:2.5rem 0 2rem}.hero h1{font-size:clamp(2.6rem,13vw,4rem)}.intro{font-size:1.05rem;line-height:1.65}.record{grid-template-columns:1fr 1fr;margin-bottom:4rem}.record div{padding:1.1rem .75rem 1.1rem 0}.story{max-width:none}.story :global(h2){margin-top:2.75rem;font-size:1.7rem}.story :global(p){font-size:1.03rem;line-height:1.8}.story :global(img){width:100%;margin:2.25rem 0}.story :global(figure){margin:2.25rem 0}}
</style>
