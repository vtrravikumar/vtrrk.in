---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { load } from "js-yaml";

type JourneyData = {
  title: string;
  country: string;
  region?: string;
  from: string;
  to: string;
  duration_days?: number;
  travelled_with?: string[];
  travel_type?: string;
  solo?: boolean;
  banner?: string;
  intro?: string;
};

const markdownModules = import.meta.glob("../../../content/travel/india/*/*.md", { eager: true });
const journeyModules = import.meta.glob("../../../content/travel/india/*/*.yaml", { eager: true, query: "?raw", import: "default" });

export function getStaticPaths() {
  return Object.entries(journeyModules).map(([path, raw]) => {
    const data = load(raw as string) as JourneyData;
    const slug = path.split("/").at(-2) ?? data.title.toLowerCase().replace(/\s+/g, "-");
    return { params: { journey: slug }, props: { data, path } };
  });
}

const { data, path } = Astro.props as { data: JourneyData; path: string };
const markdownPath = path.replace(/\.yaml$/, ".md");
const storyModule = markdownModules[markdownPath] as { Content: unknown } | undefined;
const Story = storyModule?.Content;
const formatDate = (value: string) => new Date(`${value}T00:00:00`).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
const companion = data.travelled_with?.join(", ") || (data.solo ? "Solo" : "");
---
<BaseLayout title={`${data.title} — India Travel — V.T.R. Ravi Kumar`} description={`A personal travelogue from ${data.title}, India.`}>
  <main>
    <a class="back" href="/travel/india/">← India journeys</a>
    <img class="banner" src={data.banner ?? `/images/travel/${data.title.toLowerCase().replace(/\s+/g, "-")}.jpg`} alt={`${data.title} travel banner`} />
    <header>
      <p class="label">India · {data.region ?? "Journey"}</p>
      <h1>{data.title}</h1>
      <p class="intro">{data.intro ?? `A personal travelogue from ${data.title}.`}</p>
    </header>
    <section class="record">
      <div><span>Dates</span><strong>{formatDate(data.from)} – {formatDate(data.to)}</strong></div>
      {data.duration_days && <div><span>Duration</span><strong>{data.duration_days} days</strong></div>}
      {data.travelled_with && <div><span>Travelled with</span><strong>{companion}</strong></div>}
      {data.travel_type && <div><span>Journey</span><strong>{data.travel_type}</strong></div>}
    </section>
    {Story && <article class="story"><Story /></article>}
  </main>
</BaseLayout>
<style>
main{width:min(1000px,calc(100% - 3rem));margin:0 auto;padding-bottom:6rem}.back{display:inline-block;margin:3rem 0 1.5rem;color:var(--muted);text-decoration:none}.banner{display:block;width:100%;aspect-ratio:2.2/1;object-fit:cover;object-position:center;border-radius:2px}header{padding:4rem 0 3rem;max-width:800px}.label{color:var(--muted);font-size:.78rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase}h1{margin:.5rem 0 1rem;font-size:clamp(2.8rem,6vw,4.5rem);line-height:1;letter-spacing:-.04em}.intro{font-size:1.2rem;line-height:1.65;color:var(--muted)}.record{border-top:1px solid color-mix(in srgb,var(--foreground) 15%,transparent);border-bottom:1px solid color-mix(in srgb,var(--foreground) 15%,transparent);display:grid;grid-template-columns:repeat(4,1fr);margin-bottom:5rem}.record div{padding:1.5rem 1rem 1.5rem 0}.record span{display:block;color:var(--muted);font-size:.75rem;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.5rem}.record strong{font-size:.95rem;font-weight:500}.story{max-width:900px}.story :global(h1){display:none}.story :global(h2){font-size:2rem;line-height:1.15;margin:3rem 0 1rem}.story :global(p){font-size:1.08rem;line-height:1.8;margin:0 0 1.25rem}.story :global(ul){line-height:1.8}@media(max-width:700px){main{width:min(100% - 2rem,1000px)}.record{grid-template-columns:1fr 1fr;margin-bottom:4rem}.banner{aspect-ratio:1.8/1}header{padding:3rem 0 2rem}}
</style>
