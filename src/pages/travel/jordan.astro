---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Content as JordanStory } from "../../content/travel/jordan/jordan.md";
---
<BaseLayout title="Jordan — Travel — V.T.R. Ravi Kumar" description="A personal travelogue from a solo journey through Jordan in 2019.">
  <main>
    <a class="back" href="/travel/">← Travel</a>
    <img class="banner" src="/images/travel/jordan.jpg" alt="Petra, Jordan" />
    <header>
      <p class="label">Asia · Jordan</p>
      <h1>Jordan</h1>
      <p class="intro">A solo journey where uncertainty became part of the fun.</p>
    </header>
    <section class="record">
      <div><span>Visits</span><strong>1</strong></div>
      <div><span>Visit</span><strong>30 Nov – 5 Dec 2019</strong></div>
      <div><span>Travelled</span><strong>Solo</strong></div>
      <div><span>From</span><strong>Dubai</strong></div>
    </section>
    <article class="story"><JordanStory /></article>
  </main>
</BaseLayout>
<style>
main{width:min(1000px,calc(100% - 3rem));margin:0 auto;padding-bottom:6rem}.back{display:inline-block;margin:3rem 0 1.5rem;color:var(--muted);text-decoration:none}.banner{display:block;width:100%;aspect-ratio:2.2/1;object-fit:cover;object-position:center;border-radius:2px}header{padding:4rem 0 3rem;max-width:800px}.label{color:var(--muted);font-size:.78rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase}h1{margin:.5rem 0 1rem;font-size:clamp(2.8rem,6vw,4.5rem);line-height:1;letter-spacing:-.04em}.intro{font-size:1.2rem;line-height:1.65;color:var(--muted)}.record{border-top:1px solid color-mix(in srgb,var(--foreground) 15%,transparent);border-bottom:1px solid color-mix(in srgb,var(--foreground) 15%,transparent);display:grid;grid-template-columns:repeat(4,1fr);margin-bottom:5rem}.record div{padding:1.5rem 1rem 1.5rem 0}.record span{display:block;color:var(--muted);font-size:.75rem;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.5rem}.record strong{font-size:.95rem;font-weight:500}.story{max-width:900px}.story :global(h1){display:none}.story :global(h2){font-size:2rem;line-height:1.15;margin:3rem 0 1rem}.story :global(p){font-size:1.08rem;line-height:1.8;margin:0 0 1.25rem}.story :global(ul){line-height:1.8}@media(max-width:700px){main{width:min(100% - 2rem,1000px)}.record{grid-template-columns:1fr 1fr;margin-bottom:4rem}.banner{aspect-ratio:1.8/1}header{padding:3rem 0 2rem}}
</style>
