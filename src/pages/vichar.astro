---
import BaseLayout from "../layouts/BaseLayout.astro";

// Cloudflare Pages exposes the source commit for each production build.
const vicharBuild = (globalThis as typeof globalThis & { process?: { env?: Record<string, string | undefined> } }).process?.env?.CF_PAGES_COMMIT_SHA?.slice(0, 7) ?? "unavailable";

const topics = [
  "Technology & AI",
  "Photography",
  "Royal Enfield & Riding",
  "Travel & Exploration",
  "Life & Observations",
  "Surprise me",
];
---

<BaseLayout
  title="Vichar — By VTRRK"
  description="Vichar — विचार. From thought to expression. An AI writing companion for X that keeps you in control."
>
  <main class="vichar-page">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-dot"></span> AI writing companion for X</p>
        <h1 id="hero-title">Vichar<span class="hero-dash"> — </span><span class="hero-sanskrit" lang="sa">विचार</span></h1>
        <p class="hero-tagline">From thought to expression.</p>
        <p class="intro">Have an idea? Vichar helps turn it into a concise, engaging post while leaving the final words — and the final decision — to you.</p>

        <blockquote class="sanskrit-quote">
          <span class="quote-mark" aria-hidden="true">“</span>
          <div>
            <p class="sanskrit-line" lang="sa">विचारात् निर्मीयते स्पष्टता।</p>
            <p class="transliteration">Vicārāt nirmīyate spaṣṭatā.</p>
            <p class="translation">From thought comes clarity.</p>
          </div>
        </blockquote>

        <div class="hero-actions">
          <a class="primary-link" href="https://chromewebstore.google.com/detail/klkdfdciehojgemkgfngmceigfcgnmhb" target="_blank" rel="noopener noreferrer"><span class="chrome-mark" aria-hidden="true">◉</span> Get the Chrome Extension <span aria-hidden="true">↗</span></a>
          <a class="secondary-link" href="#how-it-works">Learn more <span aria-hidden="true">↓</span></a>
        </div>
        <p class="human-control-note">Review, edit and post yourself. Vichar never posts to X for you.</p>
      </div>

      <section class="creator" aria-labelledby="create-heading">
        <div class="creator-card">
          <div class="creator-heading">
            <div>
              <p class="section-kicker">Your writing space</p>
              <h2 id="create-heading">Create with Vichar</h2>
            </div>
            <span class="version-pill"><span class="live-dot"></span> News-aware · V3</span>
          </div>

          <div class="controls">
            <label class="topic-field">
              <span>Topic or idea</span>
              <select id="topic-input">
                {topics.map((item) => <option value={item}>{item}</option>)}
                <option value="__custom__">Write your own…</option>
              </select>
            </label>
            <label id="custom-topic-wrap" class="custom-topic" hidden>
              <span>Your topic <em id="topic-count">0 / 40</em></span>
              <textarea id="custom-topic" placeholder="A few words, e.g. AI and creativity" maxlength="40" rows="1"></textarea>
            </label>
            <div class="field-row">
              <label>
                <span>Style</span>
                <div id="style-used" class="static-field"><span class="field-icon" aria-hidden="true">✧</span><span>Random — revealed after generation</span></div>
              </label>
              <label>
                <span>Location <em>optional · worldwide</em></span>
                <input id="location" type="text" placeholder="e.g. Tokyo or Chennai" maxlength="80" />
              </label>
            </div>
            <label class="news-toggle" for="use-news">
              <input id="use-news" type="checkbox" />
              <span>Use recent news <em>Only stories from the last 48 hours</em></span>
            </label>
          </div>

          <div class="actions">
            <button id="create" type="button"><span>Create ideas</span><span aria-hidden="true">✦</span></button>
            <span id="status" role="status" aria-live="polite">Ready when you are.</span>
          </div>
          <p class="topic-hints"><span aria-hidden="true">✧</span> Try: AI, photography, travel, productivity, everyday observations…</p>

          <div id="news-sources" class="news-sources" hidden aria-label="News sources"></div>

          <div id="result-wrap" class="result-wrap" hidden>
            <div class="result-heading">
              <div><p class="section-kicker">Your expression</p><span class="review-hint">Edit it. Make it yours.</span></div>
              <span id="count">0 / 140</span>
            </div>
            <textarea id="tweet" maxlength="140" rows="4" spellcheck="true" aria-label="Generated post"></textarea>
            <div class="result-footer">
              <button id="tweet-this" type="button" class="secondary-button">Tweet this ↗</button>
              <button id="another" type="button" class="text-button">Create another ↻</button>
            </div>
          </div>
          <p class="privacy-note"><span aria-hidden="true">♧</span> Your words stay yours. Review and publish manually.</p>
        </div>
      </section>
    </section>

    <section id="how-it-works" class="features" aria-label="How Vichar helps">
      <article class="feature-card">
        <span class="feature-icon idea-icon" aria-hidden="true">✧</span>
        <h3>Start with a thought</h3>
        <p>Enter any topic, idea or angle. Keep it simple — just what's on your mind.</p>
      </article>
      <article class="feature-card">
        <span class="feature-icon explore-icon" aria-hidden="true">☷</span>
        <h3>Explore ideas</h3>
        <p>Get a concise starting point shaped by your topic and writing style.</p>
      </article>
      <article class="feature-card">
        <span class="feature-icon refine-icon" aria-hidden="true">✎</span>
        <h3>Refine in your voice</h3>
        <p>Edit and fine-tune the text until it sounds like you.</p>
      </article>
      <article class="feature-card">
        <span class="feature-icon share-icon" aria-hidden="true">↗</span>
        <h3>Use it in X</h3>
        <p>Open the X composer with your draft. You stay in control.</p>
      </article>
    </section>

    <section class="trust-strip" aria-label="Privacy and control">
      <div class="trust-item"><span class="trust-icon" aria-hidden="true">◇</span><div><h3>Privacy by design</h3><p>Vichar doesn't access your X credentials or post automatically.</p></div></div>
      <div class="trust-item"><span class="trust-icon" aria-hidden="true">◎</span><div><h3>You stay in control</h3><p>Review, edit and make the final publishing decision.</p></div></div>
      <div class="trust-item"><span class="trust-icon" aria-hidden="true">⌑</span><div><h3>No post history stored</h3><p>Your generated post isn't saved by Vichar.</p></div></div>
      <div class="trust-sanskrit"><p lang="sa">विचारः सृजनस्य प्रेरणा।</p><span>Vicāraḥ sṛjanasya preraṇā.</span><em>Thought is the inspiration for creation.</em></div>
    </section>

    <footer class="vichar-footer">
      <div class="footer-brand"><strong>Vichar — विचार</strong><span class="footer-divider">|</span><span>By VTRRK</span><em>Think it. Shape it. Make it yours.</em></div>
      <div class="footer-build"><span class="version-badge">V3</span><span class="footer-separator" aria-hidden="true">·</span><span class="build-label" title="Cloudflare Pages source commit">Build <code>{vicharBuild}</code></span><span class="footer-separator" aria-hidden="true">·</span><span>vtrrk.in/vichar</span></div>
      <div class="footer-links"><a href="/vichar/privacy/">Privacy Policy</a><a href="mailto:hello@vtrrk.in">Contact</a></div>
    </footer>
  </main>
</BaseLayout>

<script>
  const API_URL = "https://api.vtrrk.in/vichar/v2/tweet/generate";
  const SESSION_URL = "https://api.vtrrk.in/vichar/v1/web/session";
  const MAX_LENGTH = 140;

  const VICHAR_STYLES = ["thoughtful", "conversational", "witty", "observational", "curious", "provocative", "inspirational", "minimalist"];

  const topic = document.querySelector("#topic-input");
  const customTopicWrap = document.querySelector("#custom-topic-wrap");
  const customTopic = document.querySelector("#custom-topic");
  const topicCount = document.querySelector("#topic-count");
  const location = document.querySelector("#location");
  const useNews = document.querySelector("#use-news");
  const newsSources = document.querySelector("#news-sources");
  const create = document.querySelector("#create");
  const another = document.querySelector("#another");
  const tweetThis = document.querySelector("#tweet-this");
  const tweet = document.querySelector("#tweet");
  const count = document.querySelector("#count");
  const status = document.querySelector("#status");
  const resultWrap = document.querySelector("#result-wrap");
  const styleUsed = document.querySelector("#style-used");
  let webToken = "";
  let lastTopic = "";

  function updateCustomTopicVisibility() {
    const isCustom = topic.value === "__custom__";
    customTopicWrap.hidden = !isCustom;
    if (isCustom) customTopic.focus();
  }

  topic.addEventListener("change", updateCustomTopicVisibility);

  function updateTopicCount() {
    topicCount.textContent = customTopic.value.length + " / 40";
  }

  customTopic.addEventListener("input", updateTopicCount);
  let tokenExpiresAt = 0;

  async function getWebToken() {
    if (webToken && Date.now() < tokenExpiresAt - 30_000) return webToken;
    const response = await fetch(SESSION_URL, { method: "POST", headers: { "content-type": "application/json" }, cache: "no-store" });
    const payload = await response.json().catch(() => ({}));
    if (!response.ok || typeof payload.token !== "string") throw new Error(payload?.error?.message || "Vichar web access is unavailable.");
    webToken = payload.token;
    tokenExpiresAt = Date.now() + Number(payload.expiresIn || 600) * 1000;
    return webToken;
  }

  function updateCount() {
    count.textContent = tweet.value.length + " / " + MAX_LENGTH;
    count.toggleAttribute("data-over", tweet.value.length > MAX_LENGTH);
  }

  function chooseTopic() {
    if (topic.value === "__custom__") {
      const value = customTopic.value.trim();
      if (!value) throw new Error("Please enter your own topic or idea.");
      return value;
    }
    if (topic.value !== "Surprise me") return topic.value;
    const choices = topics.filter((value) => value !== "Surprise me" && value !== lastTopic);
    return choices[Math.floor(Math.random() * choices.length)] ?? topics[0];
  }

  function pickRandomStyle() {
    return VICHAR_STYLES[Math.floor(Math.random() * VICHAR_STYLES.length)];
  }

  async function generate() {
    let selectedTopic;
    try { selectedTopic = chooseTopic(); }
    catch (error) {
      status.textContent = error instanceof Error ? error.message : "Please enter a topic.";
      status.setAttribute("data-error", "");
      return;
    }

    lastTopic = selectedTopic;
    create.disabled = true;
    another.disabled = true;
    status.textContent = "Thinking…";
    status.removeAttribute("data-error");

    try {
      const token = await getWebToken();
      const response = await fetch(API_URL, {
        method: "POST",
        headers: { "content-type": "application/json", authorization: "Bearer " + token },
        body: JSON.stringify({ topic: selectedTopic, location: location.value.trim(), style: pickRandomStyle(), maxLength: MAX_LENGTH, useNews: useNews.checked }),
      });
      const payload = await response.json().catch(() => ({}));
      if (response.status === 401) {
        webToken = "";
        tokenExpiresAt = 0;
        throw new Error("Vichar web access expired. Please try again.");
      }
      if (!response.ok || typeof payload.tweet !== "string") throw new Error(payload?.error?.message || "Tweet creation failed.");
      tweet.value = payload.tweet;
      if (typeof payload.style === "string" && payload.style.trim()) {
        const styleLabel = document.createElement("span");
        styleLabel.textContent = "Style used: " + payload.style;
        styleUsed.replaceChildren(styleUsed.firstElementChild, styleLabel);
      } else {
        const styleLabel = document.createElement("span");
        styleLabel.textContent = "Style used: not provided";
        styleUsed.replaceChildren(styleUsed.firstElementChild, styleLabel);
      }
      resultWrap.hidden = false;
      updateCount();
      status.textContent = "Ready to review.";
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : "Something went wrong.";
      status.setAttribute("data-error", "");
    } finally {
      create.disabled = false;
      another.disabled = false;
    }
  }

  create.addEventListener("click", generate);
  another.addEventListener("click", generate);
  tweet.addEventListener("input", updateCount);

  tweetThis.addEventListener("click", () => {
    const text = tweet.value.trim();
    if (!text) return;
    const url = "https://x.com/intent/post?text=" + encodeURIComponent(text);
    window.open(url, "_blank", "noopener,noreferrer");
  });

</script>
<style>
  .vichar-page{width:min(1080px,calc(100% - 3rem));margin:0 auto;padding:1.2rem 0 1.5rem;color:var(--foreground)}
  .hero{display:grid;grid-template-columns:minmax(330px,.72fr) minmax(0,1.45fr);gap:clamp(2rem,4vw,4.5rem);align-items:start;padding:1.2rem 0 2.2rem;position:relative}
  .hero::before{content:"";position:absolute;z-index:-1;inset:0 -2rem;background:radial-gradient(ellipse at 72% 38%,rgba(57,137,255,.14),transparent 42%),radial-gradient(ellipse at 15% 95%,rgba(83,181,255,.1),transparent 38%);pointer-events:none}
  .hero-copy{padding:.8rem 0 .5rem;min-width:0}
  .eyebrow,.section-kicker{margin:0 0 .8rem;font-size:.68rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}
  .eyebrow{display:inline-flex;align-items:center;gap:.5rem;padding:.42rem .7rem;border-radius:999px;background:var(--accent-soft)}
  .eyebrow-dot,.live-dot{width:.48rem;height:.48rem;display:inline-block;border-radius:50%;background:#1aaf83}
  .hero h1{margin:.45rem 0 .1rem;font-size:clamp(3rem,4.6vw,4.8rem)!important;line-height:.98;letter-spacing:-.075em}
  .hero-dash{color:var(--accent);font-weight:400}
  .hero-sanskrit{color:var(--accent);letter-spacing:-.04em}
  .hero-tagline{margin:.3rem 0 1rem;font-size:clamp(1.7rem,2.7vw,2.65rem);line-height:1.12;letter-spacing:-.05em}
  .intro{max-width:37rem;margin:0;font-size:clamp(1rem,1.25vw,1.18rem);line-height:1.55;color:var(--foreground)}
  .sanskrit-quote{display:flex;gap:.7rem;margin:1.35rem 0 1.35rem;padding:0;border:0}
  .quote-mark{font-family:Georgia,serif;font-size:4rem;line-height:.9;color:#b9d8ff}
  .sanskrit-quote p{margin:0}
  .sanskrit-line{font-size:clamp(1.2rem,1.65vw,1.65rem);line-height:1.45;color:var(--accent);font-weight:650}
  .transliteration{margin-top:.2rem!important;font-size:.88rem;font-style:italic;color:var(--muted)}
  .translation{margin-top:.05rem!important;font-size:.9rem;font-style:italic;color:var(--muted)}
  .hero-actions{display:flex;align-items:center;gap:.7rem;flex-wrap:wrap;margin-top:1.3rem}
  .primary-link,.secondary-link{display:inline-flex;align-items:center;justify-content:center;gap:.6rem;border-radius:999px;text-decoration:none;font-size:.83rem;font-weight:750;transition:transform .18s ease,box-shadow .18s ease}
  .primary-link{padding:.8rem 1rem;color:#fff;background:linear-gradient(110deg,#1477ff,#0754d8);box-shadow:0 8px 22px rgba(20,119,255,.16)}
  .secondary-link{padding:.75rem .9rem;border:1px solid var(--border);color:var(--foreground);background:var(--surface)}
  .primary-link:hover,.secondary-link:hover{transform:translateY(-1px)}
  .chrome-mark{font-size:1.15rem;color:#ffcf4a}
  .human-control-note{margin:.8rem 0 0;color:var(--muted);font-size:.75rem;line-height:1.5}
  .creator{min-width:0;scroll-margin-top:1rem}
  .creator-card{padding:clamp(1.1rem,2vw,1.7rem);border:1px solid rgba(100,145,210,.2);border-radius:1.35rem;background:rgba(255,255,255,.83);box-shadow:0 18px 55px rgba(42,91,155,.1);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}
  .creator-heading{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1.1rem}
  .creator-heading .section-kicker{margin-bottom:.3rem}
  .creator-heading h2{margin:0;font-size:clamp(1.45rem,2.1vw,2rem);letter-spacing:-.055em}
  .version-pill{display:inline-flex;align-items:center;gap:.45rem;white-space:nowrap;border-radius:999px;padding:.45rem .65rem;background:#e5f8f1;color:#087b5d;font-size:.7rem;font-weight:750}
  .controls{display:grid;grid-template-columns:1fr;gap:.8rem}
  label{display:grid;gap:.45rem;color:var(--muted);font-size:.75rem;font-weight:700}
  label em{font-style:normal;font-size:.67rem;font-weight:450;opacity:.78}
  .topic-field textarea{min-height:3.5rem;max-height:3.5rem;resize:none}
  .custom-topic textarea{min-height:2.8rem;max-height:2.8rem;resize:none}
  #topic-count{margin-left:.35rem;font-variant-numeric:tabular-nums;font-weight:500}
  select,input,textarea{width:100%;box-sizing:border-box;border:1px solid var(--border);border-radius:.75rem;background:rgba(255,255,255,.82);color:var(--foreground);font:inherit;outline:none;transition:border-color .2s ease,box-shadow .2s ease}
  select,input{height:2.8rem;padding:0 .8rem}
  textarea{min-height:6.8rem;padding:.8rem .9rem;resize:vertical;line-height:1.5}
  select:focus,input:focus,textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
  .field-row{display:grid;grid-template-columns:1fr 1fr;gap:.7rem}
  .static-field{height:2.8rem;box-sizing:border-box;display:flex;align-items:center;gap:.6rem;padding:0 .8rem;border:1px solid var(--border);border-radius:.75rem;background:rgba(255,255,255,.55);color:var(--foreground);font-size:.85rem;font-weight:500}
  .field-icon{font-size:1.15rem;color:var(--accent)}
  .custom-topic[hidden]{display:none}
  .actions{display:flex;align-items:stretch;flex-direction:column;gap:.55rem;margin-top:1rem}
  button{border:0;border-radius:999px;font:inherit;font-weight:750;padding:.78rem 1rem;cursor:pointer;transition:transform .2s ease,opacity .2s ease,background .2s ease}
  button:hover{transform:translateY(-1px)}
  button:disabled{opacity:.45;cursor:wait;transform:none}
  #create{width:100%;display:flex;align-items:center;justify-content:center;gap:.6rem;color:#fff;background:linear-gradient(105deg,#1477ff,#0754d8);box-shadow:0 8px 20px rgba(20,119,255,.16)}
  #status{color:var(--muted);font-size:.75rem;flex-shrink:0;min-height:1.1em}
  #status[data-error]{color:#b42318}
  .topic-hints{margin:.75rem 0 0;font-size:.74rem;line-height:1.5;color:var(--muted)}
  .topic-hints span{color:var(--accent)}
  .result-wrap{margin-top:1.25rem;padding-top:1.1rem;border-top:1px solid var(--border)}
  .result-heading{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:.65rem}
  .result-heading .section-kicker{margin:0}
  .review-hint{display:block;color:var(--muted);font-size:.75rem}
  .style-used{display:block;margin-top:.35rem;color:var(--accent);font-size:.7rem;font-weight:700;letter-spacing:.02em}
  #count{color:var(--muted);font-size:.72rem}
  #count[data-over]{color:#b42318;font-weight:800}
  .result-footer{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:.65rem}
  .secondary-button{background:var(--accent-soft);color:var(--accent);padding:.58rem .9rem}
  .text-button{background:transparent;color:var(--accent);padding:.4rem 0;font-size:.8rem}
  .privacy-note{margin:1rem 0 0;padding-top:.8rem;border-top:1px solid rgba(100,145,210,.16);color:var(--muted);font-size:.72rem}
  .features{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem;padding:.2rem 0 1rem}
  .feature-card{min-width:0;padding:1.15rem 1.2rem;border:1px solid var(--border);border-radius:1.1rem;background:rgba(255,255,255,.58)}
  .feature-icon{display:grid;place-items:center;width:2.8rem;height:2.8rem;margin-bottom:.65rem;border-radius:50%;font-size:1.55rem;font-weight:700}
  .idea-icon{background:#e4efff;color:#1677ff}.explore-icon{background:#f0eaff;color:#7250ff}.refine-icon{background:#e0f7f0;color:#0b9d83}.share-icon{background:#ffebeb;color:#e74444}
  .feature-card h3,.trust-item h3{margin:0;font-size:1rem;letter-spacing:-.025em}
  .feature-card p,.trust-item p{margin:.35rem 0 0;color:var(--muted);font-size:.84rem;line-height:1.5}
  .trust-strip{display:grid;grid-template-columns:1fr 1fr 1fr 1.1fr;align-items:center;gap:1rem;margin:.2rem 0 1rem;padding:1rem 1.1rem;border:1px solid rgba(95,151,224,.12);border-radius:1.1rem;background:linear-gradient(105deg,rgba(220,237,255,.8),rgba(235,242,255,.72))}
  .trust-item{display:flex;align-items:center;gap:.65rem;min-width:0}
  .trust-icon{display:grid;place-items:center;flex:0 0 2.6rem;height:2.6rem;border-radius:50%;background:rgba(255,255,255,.5);color:#0754d8;font-size:1.55rem}
  .trust-sanskrit{border-left:2px solid var(--accent);padding-left:1rem;text-align:center}
  .trust-sanskrit p{margin:0;font-size:1.15rem;color:var(--foreground)}
  .trust-sanskrit span,.trust-sanskrit em{display:block;color:var(--muted);font-size:.75rem;font-style:italic;line-height:1.5}
  .vichar-footer{display:flex;justify-content:space-between;align-items:center;gap:1rem;border-top:1px solid var(--border);padding:1rem .5rem .2rem;color:var(--muted);font-size:.74rem}
  .footer-brand,.footer-build,.footer-links{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap}
  .footer-brand strong{color:var(--foreground)}
  .footer-brand em{margin-left:.35rem;font-size:.7rem}
  .footer-divider,.footer-separator{color:#a0a6b2}
  .version-badge{display:inline-grid;place-items:center;min-width:2.5rem;height:1.8rem;padding:0 .4rem;box-sizing:border-box;border-radius:.65rem;background:linear-gradient(120deg,#1680ff,#0754d8);color:#fff;font-weight:800}
  .build-label{display:inline-flex;align-items:center;gap:.3rem;border:1px solid var(--border);border-radius:.65rem;padding:.35rem .55rem;background:var(--surface);color:var(--foreground)}
  .build-label code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.7rem;color:var(--muted)}
  .footer-links{gap:1rem}.footer-links a{color:var(--muted);text-decoration:none}.footer-links a:hover{color:var(--accent);text-decoration:underline;text-underline-offset:.2em}
  @media(max-width:1100px){
    .vichar-page{width:min(1080px,calc(100% - 2rem))}
    .hero{grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:1.5rem}
    .hero h1{font-size:clamp(2.8rem,4.4vw,4.1rem)!important}
    .hero-tagline{font-size:clamp(1.5rem,2.4vw,2.1rem)}
    .trust-strip{grid-template-columns:1fr 1fr}
    .trust-sanskrit{border-left:0;border-top:1px solid rgba(20,119,255,.2);padding:1rem 0 0}
  }
  @media(max-width:760px){
