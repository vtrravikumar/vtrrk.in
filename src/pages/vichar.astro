---
import BaseLayout from "../layouts/BaseLayout.astro";

const topics = [
  "Technology & AI",
  "Photography",
  "Royal Enfield & Riding",
  "Travel & Exploration",
  "Life & Observations",
  "Surprise me",
];
---

<BaseLayout
  title="Vichar — By VTRRK"
  description="From thought to expression. Create concise, personalized posts in the voice of V.T.R. Ravi Kumar."
>
  <main class="vichar-page">
    <header class="hero">
      <div class="hero-copy">
        <img class="brand-lockup" src="/brand/vichar-lockup-320.webp" alt="Vichar — By VTRRK" width="320" height="107" />
        <p class="eyebrow">AI writing companion</p>
        <h1>From thought<br /><span>to expression.</span></h1>
        <p class="intro">Have an idea? Vichar helps turn it into a concise, engaging post while leaving the final words — and the final decision — to you.</p>
      </div>
      <div class="hero-note"><span class="note-line"></span><p>Think it.<br />Shape it.<br />Make it yours.</p></div>
    </header>

    <section class="creator" aria-labelledby="create-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Create</p>
          <h2 id="create-heading">What are you thinking about?</h2>
        </div>
        <p class="section-description">Choose a topic or write your own.</p>
      </div>

      <div class="creator-card">
        <div class="controls">
          <label>
            <span>Topic</span>
            <select id="topic">
              {topics.map((item) => <option value={item}>{item}</option>)}
              <option value="__custom__">Write your own…</option>
            </select>
          </label>

          <label id="custom-topic-wrap" class="custom-topic" hidden>
            <span>Your topic</span>
            <input id="custom-topic" type="text" placeholder="e.g. What AI means for everyday creativity" maxlength="160" />
          </label>

          <label>
            <span>Location <em>optional</em></span>
            <input id="location" type="text" placeholder="e.g. Chennai" maxlength="80" />
          </label>
        </div>

        <div class="actions">
          <button id="create" type="button"><span>Create a thought</span><span aria-hidden="true">→</span></button>
          <span id="status" role="status" aria-live="polite">Ready when you are.</span>
        </div>

        <div id="result-wrap" class="result-wrap" hidden>
          <div class="result-heading">
            <div><p class="section-kicker">Your expression</p><span class="review-hint">Edit it. Make it yours.</span></div>
            <span id="count">0 / 140</span>
          </div>
          <textarea id="tweet" maxlength="140" rows="4" spellcheck="true"></textarea>
          <div class="result-footer">
            <button id="copy" type="button" class="secondary">Copy</button>
            <button id="another" type="button" class="text-button">Create another →</button>
          </div>
        </div>

        <p class="note">Review, edit and post yourself. Vichar never posts to X for you.</p>
      </div>
    </section>

    <footer class="vichar-footer">
      <span>Vichar — By VTRRK</span><span aria-hidden="true">·</span><a href="/vichar/privacy/">Privacy Policy</a>
    </footer>
  </main>
</BaseLayout>

<script>
  const API_URL = "https://tweetpilot-api.vtrravikumar.workers.dev/v1/tweet/generate";
  const SESSION_URL = "https://tweetpilot-api.vtrravikumar.workers.dev/v1/web/session";
  const MAX_LENGTH = 140;

  const VICHAR_STYLES = ["thoughtful", "conversational", "witty", "observational", "curious", "provocative", "inspirational", "minimalist"];

  const topic = document.querySelector("#topic");
  const customTopicWrap = document.querySelector("#custom-topic-wrap");
  const customTopic = document.querySelector("#custom-topic");
  const location = document.querySelector("#location");
  const create = document.querySelector("#create");
  const another = document.querySelector("#another");
  const copy = document.querySelector("#copy");
  const tweet = document.querySelector("#tweet");
  const count = document.querySelector("#count");
  const status = document.querySelector("#status");
  const resultWrap = document.querySelector("#result-wrap");

  const topicOptions = Array.from(topic.options).map((option) => option.value);
  let lastTopic = "";
  let webToken = "";
  let tokenExpiresAt = 0;

  function updateCustomTopicVisibility() {
    const isCustom = topic.value === "__custom__";
    customTopicWrap.hidden = !isCustom;
    if (isCustom) customTopic.focus();
  }

  topic.addEventListener("change", updateCustomTopicVisibility);

  async function getWebToken() {
    if (webToken && Date.now() < tokenExpiresAt - 30_000) return webToken;
    const response = await fetch(SESSION_URL, { method: "POST", headers: { "content-type": "application/json" }, cache: "no-store" });
    const payload = await response.json().catch(() => ({}));
    if (!response.ok || typeof payload.token !== "string") throw new Error(payload?.error?.message || "Vichar web access is unavailable.");
    webToken = payload.token;
    tokenExpiresAt = Date.now() + Number(payload.expiresIn || 600) * 1000;
    return webToken;
  }

  function updateCount() {
    count.textContent = tweet.value.length + " / " + MAX_LENGTH;
    count.toggleAttribute("data-over", tweet.value.length > MAX_LENGTH);
  }

  function chooseTopic() {
    if (topic.value === "__custom__") {
      const value = customTopic.value.trim();
      if (!value) throw new Error("Please enter a topic.");
      return value;
    }
    if (topic.value !== "Surprise me") return topic.value;
    const choices = topicOptions.filter((value) => value !== "Surprise me" && value !== lastTopic && value !== "__custom__");
    return choices[Math.floor(Math.random() * choices.length)] ?? topicOptions[0];
  }

  function pickRandomStyle() {
    return VICHAR_STYLES[Math.floor(Math.random() * VICHAR_STYLES.length)];
  }

  async function generate() {
    let selectedTopic;
    try { selectedTopic = chooseTopic(); }
    catch (error) {
      status.textContent = error instanceof Error ? error.message : "Please enter a topic.";
      status.setAttribute("data-error", "");
      return;
    }

    lastTopic = selectedTopic;
    create.disabled = true;
    another.disabled = true;
    status.textContent = "Thinking…";
    status.removeAttribute("data-error");

    try {
      const token = await getWebToken();
      const response = await fetch(API_URL, {
        method: "POST",
        headers: { "content-type": "application/json", authorization: "Bearer " + token },
        body: JSON.stringify({ topic: selectedTopic, location: location.value.trim(), style: pickRandomStyle(), maxLength: MAX_LENGTH }),
      });
      const payload = await response.json().catch(() => ({}));
      if (response.status === 401) {
        webToken = "";
        tokenExpiresAt = 0;
        throw new Error("Vichar web access expired. Please try again.");
      }
      if (!response.ok || typeof payload.tweet !== "string") throw new Error(payload?.error?.message || "Tweet creation failed.");
      tweet.value = payload.tweet;
      resultWrap.hidden = false;
      updateCount();
      status.textContent = "Ready to review.";
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : "Something went wrong.";
      status.setAttribute("data-error", "");
    } finally {
      create.disabled = false;
      another.disabled = false;
    }
  }

  create.addEventListener("click", generate);
  another.addEventListener("click", generate);
  tweet.addEventListener("input", updateCount);

  copy.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(tweet.value);
      copy.textContent = "Copied";
      window.setTimeout(() => { copy.textContent = "Copy"; }, 1400);
    } catch {
      tweet.focus();
      tweet.select();
      status.textContent = "Select the text and copy it manually.";
    }
  });

  updateCustomTopicVisibility();
</script>

<style>
  .vichar-page{width:min(1040px,calc(100% - 3rem));margin:0 auto;padding-bottom:3rem}
  .hero{min-height:60vh;display:grid;grid-template-columns:minmax(0,1.5fr) minmax(180px,.45fr);align-items:center;gap:4rem;padding:5rem 1rem 4rem;position:relative}
  .hero::before{content:"";position:absolute;width:26rem;height:26rem;right:8%;top:12%;border-radius:50%;background:radial-gradient(circle,var(--accent-soft),transparent 68%);filter:blur(8px);pointer-events:none}
  .hero-copy,.hero-note{position:relative;z-index:1}
  .brand-lockup{display:block;width:min(260px,70vw);height:auto;margin:0 0 2rem}
  .eyebrow,.section-kicker{margin:0 0 .8rem;font-size:.68rem;font-weight:750;letter-spacing:.15em;text-transform:uppercase;color:var(--accent)}
  h1{margin:0;font-size:clamp(3.8rem,8vw,7rem)!important;line-height:.9;letter-spacing:-.07em}
  h1 span{color:var(--muted)}
  .intro{max-width:650px;margin:1.8rem 0 0;font-size:clamp(1.1rem,2vw,1.45rem);line-height:1.5;color:var(--foreground);letter-spacing:-.015em}
  .hero-note{justify-self:end;max-width:180px;margin-top:5rem}
  .note-line{display:block;width:1px;height:4.5rem;margin-bottom:1.2rem;background:linear-gradient(var(--accent),var(--accent-creative))}
  .hero-note p{margin:0;color:var(--muted);font-size:.95rem;line-height:1.7;font-style:italic}
  .creator{border-top:1px solid var(--border);padding:4rem 1rem 2.5rem}
  .section-heading{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:1.8rem}
  .section-heading h2{margin:0;font-size:clamp(1.8rem,4vw,3rem);letter-spacing:-.05em}
  .section-description{margin:0;color:var(--muted);font-size:.82rem}
  .creator-card{padding:1.5rem;border:1px solid var(--border);border-radius:1.5rem;background:linear-gradient(145deg,var(--surface-elevated),var(--surface));box-shadow:var(--glass-shadow);backdrop-filter:blur(20px) saturate(140%);-webkit-backdrop-filter:blur(20px) saturate(140%)}
  .controls{display:grid;grid-template-columns:1.1fr .9fr;gap:1rem}
  label{display:grid;gap:.45rem;color:var(--muted);font-size:.72rem;font-weight:750;letter-spacing:.02em}
  label em{font-style:normal;font-weight:400;opacity:.7}
  select,input,textarea{width:100%;box-sizing:border-box;border:1px solid var(--border);border-radius:.8rem;background:var(--surface-elevated);color:var(--foreground);font:inherit;outline:none;transition:border-color .2s ease,box-shadow .2s ease}
  select,input{height:2.9rem;padding:0 .9rem}
  textarea{min-height:7.2rem;padding:.9rem 1rem;resize:vertical;line-height:1.5}
  select:focus,input:focus,textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
  .custom-topic{grid-column:1 / -1}
  .actions{display:flex;align-items:center;gap:1rem;margin-top:1.2rem}
  button{border:0;border-radius:999px;background:var(--foreground);color:var(--background);font:inherit;font-weight:750;padding:.72rem 1rem;cursor:pointer;transition:transform .2s ease,opacity .2s ease,background .2s ease}
  button:hover{transform:translateY(-1px);background:var(--accent)}
  button:disabled{opacity:.45;cursor:wait;transform:none}
  #create{display:inline-flex;align-items:center;gap:.8rem}
  #create span:last-child{font-size:1.1rem}
  .secondary{background:transparent;color:var(--accent);border:1px solid var(--border);padding:.58rem .9rem}
  .secondary:hover{background:var(--accent-soft);color:var(--accent)}
  #status{color:var(--muted);font-size:.76rem}
  #status[data-error]{color:#b42318}
  .result-wrap{margin-top:2rem;padding-top:1.7rem;border-top:1px solid var(--border)}
  .result-heading{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:.65rem}
  .result-heading .section-kicker{margin:0}
  .review-hint{display:block;color:var(--muted);font-size:.75rem}
  #count{color:var(--muted);font-size:.72rem}
  #count[data-over]{color:#b42318;font-weight:800}
  .result-footer{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:.65rem}
  .text-button{background:transparent;color:var(--accent);padding:.25rem 0;font-size:.8rem}
  .text-button:hover{background:transparent;color:var(--accent-creative)}
  .note{margin:1.5rem 0 .2rem;color:var(--muted);font-size:.74rem}
  .vichar-footer{display:flex;justify-content:center;align-items:center;gap:.6rem;border-top:1px solid var(--border);padding:1.5rem 1rem 0;color:var(--muted);font-size:.72rem}
  .vichar-footer a{color:var(--muted);text-decoration:none}
  .vichar-footer a:hover{color:var(--accent);text-decoration:underline;text-underline-offset:.2em}
  @media(max-width:760px){
    .vichar-page{width:min(100% - 1.5rem,1040px)}
    .hero{min-height:auto;grid-template-columns:1fr;gap:2rem;padding:3.5rem .5rem 4rem}
    .hero-note{justify-self:start;margin-top:0}
    .controls{grid-template-columns:1fr}
    .custom-topic{grid-column:auto}
    .section-heading{align-items:flex-start;flex-direction:column;gap:.5rem}
  }
  @media(max-width:520px){
    .hero{padding-top:2.8rem}
    h1{font-size:clamp(3.3rem,17vw,5rem)!important}
    .creator{padding-top:3rem}
    .creator-card{padding:1rem}
    .actions{align-items:flex-start;flex-direction:column}
    .result-heading{align-items:flex-start}
  }
</style>
