---
import BaseLayout from "../layouts/BaseLayout.astro";

const topics = [
  "Technology & AI",
  "Photography",
  "Royal Enfield & Riding",
  "Travel & Exploration",
  "Life & Observations",
  "Surprise me",
];
---

<BaseLayout
  title="Vichar — By VTRRK"
  description="From thought to expression. Create concise, personalized posts in the voice of V.T.R. Ravi Kumar."
>
  <BaseLayout
  title="Vichar — By VTRRK"
  description="From thought to expression. Create concise, personalized posts in the voice of V.T.R. Ravi Kumar."
>
  <main>
    <header class="hero">
      <div class="brand-lockup" aria-label="Vichar — By VTRRK">
        <div class="logo-mark" aria-hidden="true">
          <svg viewBox="0 0 64 64" role="img">
            <path class="mark-v" d="M7 12 20 52 32 29 44 52 57 12h-11L44 31 32 8 20 31 18 12Z"/>
            <path class="mark-gold" d="M23 38c4-8 9-12 15-12 4 0 7 1 10 3-4 2-8 3-12 3-4 0-8 2-13 6Z"/>
            <path class="mark-orange" d="M25 44c6-5 12-7 19-7 4 0 7 1 10 2-5 3-10 5-15 5-5 0-9 1-14 4Z"/>
          </svg>
        </div>
        <div>
          <div class="eyebrow">विचारं लभताम्</div>
          <div class="wordmark">V<span class="gold">i</span>ch<span class="orange">a</span>r</div>
          <div class="byline">BY VTRRK</div>
        </div>
      </div>

      <p class="sanskrit">विचारात् वाक्यं भवति</p>
      <h1>From thought to expression.</h1>
      <p class="intro">A personal AI writing companion for turning an idea into something worth posting.</p>
    </header>

    <section class="creator" aria-label="Vichar creator">
      <div class="controls">
        <label>
          <span>Topic</span>
          <select id="topic">
            {topics.map((topic) => <option value={topic}>{topic}</option>)}
          </select>
        </label>
        <label>
          <span>Location <em>optional</em></span>
          <input id="location" type="text" placeholder="e.g. Chennai" maxlength="80" />
        </label>
      </div>

      <div class="actions">
        <button id="create" type="button">Create a thought</button>
        <span id="status" role="status" aria-live="polite">Ready.</span>
      </div>

      <div id="result-wrap" class="result-wrap" hidden>
        <div class="result-heading">
          <label for="tweet">Your expression</label>
          <span class="review-hint">Edit before you post</span>
        </div>
        <textarea id="tweet" maxlength="140" rows="4" spellcheck="true"></textarea>
        <div class="result-footer">
          <span id="count">0 / 140</span>
          <button id="copy" type="button" class="secondary">Copy</button>
        </div>
        <button id="another" type="button" class="text-button">Create another</button>
      </div>

      <p class="note">Review, edit and post yourself. Vichar never posts to X for you.</p>
    </section>
  </main>
</BaseLayout>

<script>
  const API_URL = "https://tweetpilot-api.vtrravikumar.workers.dev/v1/tweet/generate";
  const SESSION_URL = "https://tweetpilot-api.vtrravikumar.workers.dev/v1/web/session";
  const MAX_LENGTH = 140;

  const topic = document.querySelector("#topic");
  const location = document.querySelector("#location");
  const create = document.querySelector("#create");
  const another = document.querySelector("#another");
  const copy = document.querySelector("#copy");
  const tweet = document.querySelector("#tweet");
  const count = document.querySelector("#count");
  const status = document.querySelector("#status");
  const resultWrap = document.querySelector("#result-wrap");

  const topics = Array.from(topic.options).map((option) => option.value);
  let lastTopic = "";
  let webToken = "";
  let tokenExpiresAt = 0;

  async function getWebToken() {
    if (webToken && Date.now() < tokenExpiresAt - 30_000) return webToken;

    const response = await fetch(SESSION_URL, {
      method: "POST",
      headers: { "content-type": "application/json" },
      cache: "no-store",
    });
    const payload = await response.json().catch(() => ({}));
    if (!response.ok || typeof payload.token !== "string") {
      throw new Error(payload?.error?.message || "Vichar web access is unavailable.");
    }

    webToken = payload.token;
    tokenExpiresAt = Date.now() + Number(payload.expiresIn || 600) * 1000;
    return webToken;
  }

  function updateCount() {
    count.textContent = tweet.value.length + " / " + MAX_LENGTH;
    count.toggleAttribute("data-over", tweet.value.length > MAX_LENGTH);
  }

  function chooseTopic() {
    if (topic.value !== "Surprise me") return topic.value;
    const choices = topics.filter((value) => value !== "Surprise me" && value !== lastTopic);
    return choices[Math.floor(Math.random() * choices.length)] ?? topics[0];
  }

  async function generate() {
    const selectedTopic = chooseTopic();
    lastTopic = selectedTopic;
    create.disabled = true;
    another.disabled = true;
    status.textContent = "Thinking…";
    status.removeAttribute("data-error");

    try {
      const token = await getWebToken();
      const response = await fetch(API_URL, {
        method: "POST",
        headers: {
          "content-type": "application/json",
          authorization: "Bearer " + token,
        },
        body: JSON.stringify({
          topic: selectedTopic,
          location: location.value.trim(),
          style: "thoughtful",
          maxLength: MAX_LENGTH,
        }),
      });

      const payload = await response.json().catch(() => ({}));
      if (response.status === 401) {
        webToken = "";
        tokenExpiresAt = 0;
        throw new Error("Vichar web access expired. Please try again.");
      }
      if (!response.ok || typeof payload.tweet !== "string") {
        throw new Error(payload?.error?.message || "Tweet creation failed.");
      }

      tweet.value = payload.tweet;
      resultWrap.hidden = false;
      updateCount();
      status.textContent = selectedTopic === topic.value ? "Ready to review." : "Ready to review · " + selectedTopic;
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : "Something went wrong.";
      status.setAttribute("data-error", "");
    } finally {
      create.disabled = false;
      another.disabled = false;
    }
  }

  create.addEventListener("click", generate);
  another.addEventListener("click", generate);
  tweet.addEventListener("input", updateCount);

  copy.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(tweet.value);
      copy.textContent = "Copied";
      window.setTimeout(() => { copy.textContent = "Copy"; }, 1400);
    } catch {
      tweet.focus();
      tweet.select();
      status.textContent = "Select the text and copy it manually.";
    }
  });
</script>

<style>
  main{width:min(760px,calc(100% - 2.5rem));margin:0 auto}
  .hero{padding:3.25rem 0 2.5rem}
  .brand-lockup{display:flex;align-items:center;gap:1rem}
  .logo-mark{width:58px;height:58px;flex:0 0 58px;border-radius:16px;background:#DC143C;display:grid;place-items:center;overflow:hidden}
  .logo-mark svg{width:49px;height:49px}
  .mark-v{fill:#FFF4E6}
  .mark-gold{fill:#FFC400}
  .mark-orange{fill:#FF8A00}
  .eyebrow{margin:0 0 .05rem;color:#DC143C;font-size:.68rem;font-weight:800;letter-spacing:.12em}
  .wordmark{font-size:clamp(3.2rem,8vw,5rem);line-height:.8;letter-spacing:-.075em;font-weight:900;color:#DC143C}
  .gold{color:#FFC400}.orange{color:#FF8A00}
  .byline{margin:.35rem 0 0;color:#7A1025;font-size:.7rem;font-weight:900;letter-spacing:.13em}
  .sanskrit{color:#7A1025;font-size:.92rem;margin:1.4rem 0 .7rem}
  h1{margin:0;font-size:clamp(2.35rem,5vw,3.5rem);line-height:1;letter-spacing:-.045em}
  .intro{max-width:610px;color:var(--muted);font-size:1rem;line-height:1.55;margin:.75rem 0 0}
  .creator{border-top:2px solid #DC143C;padding:1.7rem 0 3.5rem}
  .controls{display:grid;grid-template-columns:1.25fr .75fr;gap:.8rem}
  label{display:grid;gap:.45rem;color:var(--muted);font-size:.78rem;font-weight:700}
  label em{font-style:normal;font-weight:400;opacity:.7}
  select,input,textarea{width:100%;box-sizing:border-box;border:1px solid var(--border);border-radius:.8rem;background:var(--surface);color:var(--foreground);font:inherit;outline:none}
  select,input{height:2.8rem;padding:0 .9rem}
  textarea{min-height:7.2rem;padding:.9rem 1rem;resize:vertical;line-height:1.5}
  select:focus,input:focus,textarea:focus{border-color:#DC143C}
  .actions{display:flex;align-items:center;gap:.85rem;margin-top:1rem}
  button{border:0;border-radius:999px;background:#DC143C;color:#FFF4E6;font:inherit;font-weight:800;padding:.72rem 1.05rem;cursor:pointer}
  button:hover{background:#7A1025}
  button:disabled{opacity:.45;cursor:wait}
  .secondary{background:transparent;color:#DC143C;border:1px solid #DC143C;padding:.6rem .95rem}
  .secondary:hover{background:#FFF4E6;color:#7A1025}
  #status{color:var(--muted);font-size:.78rem}
  #status[data-error]{color:#7A1025}
  .result-wrap{margin-top:1.6rem;padding-top:1.35rem;border-top:1px solid var(--border)}
  .result-heading{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;margin-bottom:.5rem}
  .result-wrap>label,.result-heading>label{color:#7A1025;font-size:.72rem;letter-spacing:.1em;text-transform:uppercase}
  .review-hint{color:var(--muted);font-size:.72rem}
  .result-footer{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:.55rem}
  #count{color:var(--muted);font-size:.72rem}
  #count[data-over]{color:#DC143C;font-weight:800}
  .text-button{margin-top:1rem;background:transparent;color:#DC143C;padding:.2rem 0;font-size:.82rem}
  .text-button:hover{background:transparent;color:#7A1025}
  .note{margin:1.7rem 0 0;color:var(--muted);font-size:.75rem}
  @media(max-width:650px){
    main{width:min(760px,calc(100% - 1.5rem))}
    .hero{padding:2.5rem 0 2rem}
    .logo-mark{width:50px;height:50px;flex-basis:50px;border-radius:14px}
    .logo-mark svg{width:43px;height:43px}
    .controls{grid-template-columns:1fr}
    .result-heading{align-items:flex-start;flex-direction:column;gap:.2rem}
  }
</style>