---
import BaseLayout from "../layouts/BaseLayout.astro";
import packageJson from "../../package.json";

const vicharVersion = `V${packageJson.version.split(".").slice(0, 2).join(".")}`;

// Cloudflare Pages exposes the source commit for each production build.
const vicharBuild = (globalThis as typeof globalThis & { process?: { env?: Record<string, string | undefined> } }).process?.env?.CF_PAGES_COMMIT_SHA?.slice(0, 7) ?? "unavailable";

const topics = [
  "Technology & AI",
  "Photography",
  "Royal Enfield & Riding",
  "Travel & Exploration",
  "Life & Observations",
  "Surprise me",
];
---

<BaseLayout
  title="Vichar — By VTRRK"
  description="Vichar — विचार. From thought to expression. An AI writing companion for X that keeps you in control."
>
  <main id="main-content" class="vichar-page" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-dot"></span> AI writing companion for X</p>
        <div class="hero-title-row">
          <img class="hero-portrait" src="/images/vichar-hero-portrait.webp" alt="Vichar’s fictional creative companion in a blue patterned top beside a laptop and Vichar mug" width="120" height="120" fetchpriority="high" />
          <h1 id="hero-title">Vichar<span class="hero-dash"> — </span><span class="hero-sanskrit" lang="sa">विचार</span></h1>
        </div>
        <p id="generation-counter" class="generation-counter" aria-live="polite"><span class="counter-dot" aria-hidden="true"></span> 500 thoughts created with Vichar</p>
        <p class="hero-tagline">From thought to expression.</p>
        <p class="intro">Have an idea? Vichar helps turn it into a concise, engaging post while leaving the final words — and the final decision — to you.</p>

        <blockquote class="sanskrit-quote">
          <span class="quote-mark" aria-hidden="true">“</span>
          <div>
            <p class="sanskrit-line" lang="sa">विचारात् निर्मीयते स्पष्टता।</p>
            <p class="transliteration">Vicārāt nirmīyate spaṣṭatā.</p>
            <p class="translation">From thought comes clarity.</p>
          </div>
        </blockquote>

        <div class="hero-actions">
          <a class="primary-link" href="https://chromewebstore.google.com/detail/klkdfdciehojgemkgfngmceigfcgnmhb" target="_blank" rel="noopener noreferrer"><span class="chrome-mark" aria-hidden="true">◉</span> Get the Chrome Extension <span aria-hidden="true">↗</span></a>
          <a class="secondary-link" href="#how-it-works">Learn more <span aria-hidden="true">↓</span></a>
        </div>
        <p class="human-control-note">Review, edit and post yourself. Vichar never posts to X for you.</p>
      </div>

      <section class="creator" aria-labelledby="create-heading">
        <div class="creator-card">
          <div class="creator-heading">
            <div>
              <p class="section-kicker">Your writing space</p>
              <h2 id="create-heading">Create with Vichar</h2>
            </div>
            <span class="version-pill"><span class="live-dot"></span> Multilingual · News-aware · {vicharVersion}</span>
          </div>

          <div class="controls">
            <div class="topic-language-row">
              <label class="topic-field">
                <span>Topic or idea</span>
                <select id="topic-input">
                  {topics.map((item) => <option value={item}>{item}</option>)}
                  <option value="__custom__">Write your own…</option>
                </select>
              </label>
              <label class="language-field">
                <span>Vichar language <em>Output language</em></span>
                <select id="language" name="language">
                  <option value="en" selected>English</option>
                  <option value="hi">Hindi — हिन्दी</option>
                  <option value="ta">Tamil — தமிழ்</option>
                  <option value="es">Spanish — Español</option>
                  <option value="pt-BR">Portuguese — Português (Brasil)</option>
                  <option value="ja">Japanese — 日本語</option>
                  <option value="id">Indonesian — Bahasa Indonesia</option>
                  <option value="ar">Arabic — العربية</option>
                  <option value="fr">French — Français</option>
                  <option value="tr">Turkish — Türkçe</option>
                  <option value="ko">Korean — 한국어</option>
                  <option value="de">German — Deutsch</option>
                </select>
              </label>
            </div>
            <label id="custom-topic-wrap" class="custom-topic" hidden>
              <span>Your topic <em id="topic-count">0 / 40</em></span>
              <textarea id="custom-topic" placeholder="A few words, e.g. AI and creativity" maxlength="40" rows="1"></textarea>
              <span class="custom-topic-note">Please avoid entering personal or sensitive information in your topic.</span>
            </label>
            <div class="field-row">
              <label>
                <span>Style</span>
                <div id="style-used" class="static-field"><span class="field-icon" aria-hidden="true">✧</span><span>Random — revealed after generation</span></div>
              </label>
              <label>
                <span>Location <em>optional · worldwide</em></span>
                <input id="location" type="text" placeholder="e.g. Tokyo or Chennai" maxlength="80" />
              </label>
            </div>
            <label class="news-toggle" for="use-news">
              <input id="use-news" type="checkbox" />
              <span>Use recent news <em>Only stories from the last 48 hours</em></span>
            </label>
          </div>

          <div class="actions">
            <button id="create" type="button"><span id="create-label">Create ideas</span><span aria-hidden="true">✦</span></button>
            <span id="status" role="status" aria-live="polite">Ready when you are.</span>
            <div id="turnstile-container" aria-label="Security verification"></div>
          </div>
          <p class="topic-hints"><span aria-hidden="true">✧</span> Try: AI, photography, travel, productivity, everyday observations…</p>

          <div id="result-wrap" class="result-wrap" hidden>
            <div class="result-heading">
              <div><p class="section-kicker">Your expression</p><span class="review-hint">Edit it. Make it yours.</span></div>
              <span id="count">0 / 140</span>
            </div>
            <textarea id="tweet" maxlength="140" rows="4" spellcheck="true" aria-label="Generated post"></textarea>
            <div class="result-footer">
              <button id="tweet-this" type="button" class="secondary-button">Tweet this ↗</button>
              <button id="another" type="button" class="text-button">Create another ↻</button>
            </div>
          </div>

          <div id="news-sources" class="news-sources" hidden aria-label="News sources"></div>
          <p class="privacy-note"><span aria-hidden="true">♧</span> Your words stay yours. Review and publish manually.</p>
        </div>
      </section>
    </section>

    <section id="how-it-works" class="features" aria-label="How Vichar helps">
      <article class="feature-card">
        <span class="feature-icon idea-icon" aria-hidden="true">✧</span>
        <h3>Start with a thought</h3>
        <p>Enter any topic, idea or angle. Keep it simple — just what's on your mind.</p>
      </article>
      <article class="feature-card">
        <span class="feature-icon explore-icon" aria-hidden="true">☷</span>
        <h3>Explore ideas</h3>
        <p>Get a concise starting point shaped by your topic and writing style.</p>
      </article>
      <article class="feature-card">
        <span class="feature-icon refine-icon" aria-hidden="true">✎</span>
        <h3>Refine in your voice</h3>
        <p>Edit and fine-tune the text until it sounds like you.</p>
      </article>
      <article class="feature-card">
        <span class="feature-icon share-icon" aria-hidden="true">↗</span>
        <h3>Use it in X</h3>
        <p>Open the X composer with your draft. You stay in control.</p>
      </article>
    </section>

    <section class="trust-strip" aria-label="Privacy and control">
      <div class="trust-item"><span class="trust-icon" aria-hidden="true">◇</span><div><h3>Privacy by design</h3><p>Vichar doesn't access your X credentials or post automatically.</p></div></div>
      <div class="trust-item"><span class="trust-icon" aria-hidden="true">◎</span><div><h3>You stay in control</h3><p>Review, edit and make the final publishing decision.</p></div></div>
      <div class="trust-item"><span class="trust-icon" aria-hidden="true">⌑</span><div><h3>No post history stored</h3><p>Your generated post isn't saved by Vichar.</p></div></div>
      <div class="trust-sanskrit"><p lang="sa">विचारः सृजनस्य प्रेरणा।</p><span>Vicāraḥ sṛjanasya preraṇā.</span><em>Thought is the inspiration for creation.</em></div>
    </section>

    <section class="support-panel" aria-labelledby="support-title">
      <div class="support-icon" aria-hidden="true">♡</div>
      <div class="support-copy">
        <h2 id="support-title">Enjoying Vichar?</h2>
        <p>Vichar is free to use. If it has been useful to you, you can support its continued development.</p>
      </div>
      <div class="support-action">
        <a class="support-link" href="https://razorpay.me/@vtr" target="_blank" rel="noopener noreferrer">
          Support Vichar <span aria-hidden="true">↗</span>
        </a>
        <span class="support-note">Completely optional</span>
      </div>
    </section>

    <footer class="vichar-footer">
      <div class="footer-brand"><strong>Vichar — विचार</strong><span class="footer-divider">|</span><span>By VTRRK</span><em>Think it. Shape it. Make it yours.</em></div>
      <div class="footer-build"><span class="version-badge">{vicharVersion}</span><span class="footer-separator" aria-hidden="true">·</span><span class="build-label" title="Cloudflare Pages source commit">Build <code>{vicharBuild}</code></span><span class="footer-separator" aria-hidden="true">·</span><span>vtrrk.in/vichar</span></div>
      <div class="footer-links"><a href="/vichar/changelog/">Version history</a><a href="/vichar/privacy/">Privacy Policy</a><a href="mailto:hello@vtrrk.in">Contact</a></div>
    </footer>
  </main>
</BaseLayout>

<script>
  import { getCreateIdeasLabel } from "../utils/vichar-language-labels.js";

  const API_URL = "https://api.vtrrk.in/vichar/v2/tweet/generate";
  const WEB_SESSION_URL = "https://api.vtrrk.in/vichar/v1/web/session";
  const STATS_URL = "https://api.vtrrk.in/vichar/v1/stats";
  const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
  const TURNSTILE_ACTION = "vichar_web_session";
  const MAX_LENGTH = 140;

  type TurnstileApi = {
    render: (container: HTMLElement, options: {
      sitekey: string;
      action: string;
      execution: "execute";
      appearance: "interaction-only";
      callback: (token: string) => void;
      "error-callback": () => void;
      "expired-callback": () => void;
    }) => string;
    execute: (widgetId: string) => void;
    reset: (widgetId: string) => void;
  };

  declare global {
    interface Window { turnstile?: TurnstileApi }
  }

  const VICHAR_STYLES = ["thoughtful", "conversational", "witty", "observational", "curious", "provocative", "inspirational", "minimalist"];

  // Astro frontmatter variables are not available in the browser script.
  const TOPICS = ["Technology & AI", "Photography", "Royal Enfield & Riding", "Travel & Exploration", "Life & Observations"];

  const topic = document.querySelector("#topic-input");
  const customTopicWrap = document.querySelector("#custom-topic-wrap");
  const customTopic = document.querySelector("#custom-topic");
  const topicCount = document.querySelector("#topic-count");
  const location = document.querySelector<HTMLInputElement>("#location")!;
  const language = document.querySelector<HTMLSelectElement>("#language")!;
  const useNews = document.querySelector<HTMLInputElement>("#use-news")!;
  const newsSources = document.querySelector<HTMLDivElement>("#news-sources")!;
  const create = document.querySelector("#create");
  const another = document.querySelector("#another");
  const tweetThis = document.querySelector("#tweet-this");
  const tweet = document.querySelector("#tweet");
  const count = document.querySelector("#count");
  const status = document.querySelector("#status");
  const resultWrap = document.querySelector("#result-wrap");
  const styleUsed = document.querySelector("#style-used");
  const generationCounter = document.querySelector<HTMLParagraphElement>("#generation-counter")!;
  let webSessionToken = "";
  let webSessionExpiresAt = 0;
  let sessionPromise: Promise<string> | null = null;
  let turnstilePromise: Promise<TurnstileApi> | null = null;
  let turnstileWidgetId = "";
  let lastTopic = "";

  function updateCustomTopicVisibility() {
    const isCustom = topic.value === "__custom__";
    customTopicWrap.hidden = !isCustom;
    if (isCustom) customTopic.focus();
  }

  topic.addEventListener("change", updateCustomTopicVisibility);

  function updateTopicCount() {
    topicCount.textContent = customTopic.value.length + " / 40";
  }

  customTopic.addEventListener("input", updateTopicCount);

  function loadTurnstile(): Promise<TurnstileApi> {
    if (window.turnstile) return Promise.resolve(window.turnstile);
    if (turnstilePromise) return turnstilePromise;
    turnstilePromise = new Promise((resolve, reject) => {
      const script = document.createElement("script");
      script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
      script.async = true;
      script.defer = true;
      script.onload = () => window.turnstile ? resolve(window.turnstile) : reject(new Error("Website verification is unavailable. Please try again."));
      script.onerror = () => reject(new Error("Website verification is unavailable. Please try again."));
      document.head.appendChild(script);
    }).catch((error) => {
      turnstilePromise = null;
      throw error;
    });
    return turnstilePromise;
  }

  async function getTurnstileResponseToken(): Promise<string> {
    if (!TURNSTILE_SITE_KEY) throw new Error("Website verification is not configured. Please try again later.");
    const turnstile = await loadTurnstile();
    const container = document.querySelector<HTMLElement>("#turnstile-container")!;
    return new Promise((resolve, reject) => {
      const fail = () => reject(new Error("Website verification could not be completed. Please try again."));
      if (!turnstileWidgetId) {
        turnstileWidgetId = turnstile.render(container, {
          sitekey: TURNSTILE_SITE_KEY,
          action: TURNSTILE_ACTION,
          execution: "execute",
          appearance: "interaction-only",
          callback: (token) => resolve(token),
          "error-callback": fail,
          "expired-callback": fail,
        });
      } else {
        turnstile.reset(turnstileWidgetId);
      }
      turnstile.execute(turnstileWidgetId);
    });
  }

  async function getWebSessionToken(): Promise<string> {
    if (webSessionToken && Date.now() < webSessionExpiresAt - 30_000) return webSessionToken;
    if (sessionPromise) return sessionPromise;

    sessionPromise = (async () => {
      const turnstileToken = await getTurnstileResponseToken();
      const response = await fetch(WEB_SESSION_URL, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ turnstileToken }),
        cache: "no-store",
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok || typeof payload.token !== "string" || typeof payload.expiresIn !== "number") {
        throw new Error(payload?.error?.message || "Vichar is temporarily unavailable. Please try again.");
      }
      webSessionToken = payload.token;
      webSessionExpiresAt = Date.now() + payload.expiresIn * 1000;
      return webSessionToken;
    })();

    try {
      return await sessionPromise;
    } finally {
      sessionPromise = null;
    }
  }

  function updateCount() {
    count.textContent = tweet.value.length + " / " + MAX_LENGTH;
    count.toggleAttribute("data-over", tweet.value.length > MAX_LENGTH);
  }

  async function refreshGenerationCount() {
    try {
      const response = await fetch(STATS_URL, { cache: "no-store" });
      if (!response.ok) return;
      const payload = await response.json();
      if (Number.isSafeInteger(payload.generations) && payload.generations >= 500) {
        generationCounter.textContent = payload.generations.toLocaleString() + " thoughts created with Vichar";
      }
    } catch {
      // Keep the launch-baseline label visible if the public stats endpoint is unavailable.
    }
  }

  void refreshGenerationCount();

  function chooseTopic() {
    if (topic.value === "__custom__") {
      const value = customTopic.value.trim();
      if (!value) throw new Error("Please enter your own topic or idea.");
      return value;
    }
    if (topic.value !== "Surprise me") return topic.value;
    const choices = TOPICS.filter((value) => value !== lastTopic);
    return choices[Math.floor(Math.random() * choices.length)] ?? TOPICS[0];
  }

  function pickRandomStyle() {
    return VICHAR_STYLES[Math.floor(Math.random() * VICHAR_STYLES.length)];
  }

  function clearNewsSources() {
    newsSources.replaceChildren();
    newsSources.hidden = true;
  }

  function renderNewsSources(sources: unknown) {
    clearNewsSources();
    if (!Array.isArray(sources) || sources.length === 0) return;
    const heading = document.createElement("p");
    heading.className = "news-sources-heading";
    heading.textContent = "Recent sources";
    newsSources.appendChild(heading);
    for (const source of sources) {
      try {
        const url = new URL(source.url);
        if (url.protocol !== "https:" || typeof source.title !== "string" || typeof source.publisher !== "string") continue;
        const link = document.createElement("a");
        link.href = url.toString();
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.textContent = source.publisher + ": " + source.title;
        newsSources.appendChild(link);
        const published = new Date(source.publishedAt);
        if (Number.isFinite(published.getTime())) {
          const time = document.createElement("span");
          time.className = "news-source-time";
          time.textContent = published.toLocaleString();
          newsSources.appendChild(time);
        }
      } catch {
        // Ignore malformed source metadata; never create unsafe links.
      }
    }
    newsSources.hidden = !newsSources.querySelector("a");
  }

  async function generate() {
    let selectedTopic;
    try { selectedTopic = chooseTopic(); }
    catch (error) {
      status.textContent = error instanceof Error ? error.message : "Please enter a topic.";
      status.setAttribute("data-error", "");
      return;
    }

    lastTopic = selectedTopic;
    create.disabled = true;
    another.disabled = true;
    status.textContent = "Thinking…";
    status.removeAttribute("data-error");
    clearNewsSources();

    try {
      const sessionToken = await getWebSessionToken();
      const response = await fetch(API_URL, {
        method: "POST",
        headers: { "content-type": "application/json", authorization: "Bearer " + sessionToken },
        body: JSON.stringify({ topic: selectedTopic, topicSource: topic.value === "__custom__" ? "custom" : "preset", location: location.value.trim(), style: pickRandomStyle(), language: language.value, maxLength: MAX_LENGTH, useNews: useNews.checked }),
      });
      const payload = await response.json().catch(() => ({}));
      if (response.status === 401 || response.status === 403) {
        webSessionToken = "";
        webSessionExpiresAt = 0;
        throw new Error("Your Vichar session expired. Please try again.");
      }
      if (!response.ok || typeof payload.tweet !== "string") throw new Error(payload?.error?.message || "Tweet creation failed.");
      void refreshGenerationCount();
      if (topic.value === "__custom__") {
        void (async () => {
          await new Promise((resolve) => window.setTimeout(resolve, 900));
        })();
      }
      tweet.value = payload.tweet;
      tweet.lang = language.value;
      if (typeof payload.style === "string" && payload.style.trim()) {
        const styleLabel = document.createElement("span");
        styleLabel.textContent = "Style used: " + payload.style;
        styleUsed.replaceChildren(styleUsed.firstElementChild, styleLabel);
      } else {
        const styleLabel = document.createElement("span");
        styleLabel.textContent = "Style used: not provided";
        styleUsed.replaceChildren(styleUsed.firstElementChild, styleLabel);
      }
      resultWrap.hidden = false;
      resultWrap.classList.remove("result-ready");
      void resultWrap.offsetWidth;
      resultWrap.classList.add("result-ready");
      resultWrap.scrollIntoView({
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
        block: "center",
      });
      updateCount();
      if (payload.mode === "news") {
        status.textContent = "Recent news found. Review the source below and edit your Vichar.";
        renderNewsSources(payload.sources);
      } else if (payload.fallbackReason === "no_recent_news") {
        status.textContent = "No recent news found for this topic. We've generated a normal Vichar instead.";
        clearNewsSources();
      } else if (payload.fallbackReason === "news_unavailable") {
        status.textContent = "News retrieval was unavailable. We've generated a normal Vichar instead.";
        clearNewsSources();
      } else {
        status.textContent = "Ready to review.";
      }
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : "Something went wrong.";
      status.setAttribute("data-error", "");
      clearNewsSources();
    } finally {
      create.disabled = false;
      another.disabled = false;
    }
  }

  create.addEventListener("click", generate);
  another.addEventListener("click", generate);
  const createLabel = document.querySelector<HTMLSpanElement>("#create-label")!;
  function updateCreateLabel() {
    createLabel.textContent = getCreateIdeasLabel(language.value);
  }
  language.addEventListener("change", () => {
    tweet.lang = language.value;
    updateCreateLabel();
  });
  updateCreateLabel();
  tweet.addEventListener("input", updateCount);

  tweetThis.addEventListener("click", () => {
    const text = tweet.value.trim();
    if (!text) return;
    const url = "https://x.com/intent/post?text=" + encodeURIComponent(text);
    window.open(url, "_blank", "noopener,noreferrer");
  });

</script>
<style>
  .vichar-page{width:min(1080px,calc(100% - 3rem));margin:0 auto;padding:1.2rem 0 1.5rem;color:var(--foreground)}
  .hero{display:grid;grid-template-columns:minmax(330px,.72fr) minmax(0,1.45fr);gap:clamp(2rem,4vw,4.5rem);align-items:start;padding:1.2rem 0 2.2rem;position:relative}
  .hero::before{content:"";position:absolute;z-index:-1;inset:0 -2rem;background:radial-gradient(ellipse at 72% 38%,rgba(57,137,255,.14),transparent 42%),radial-gradient(ellipse at 15% 95%,rgba(83,181,255,.1),transparent 38%);pointer-events:none}
  .hero-copy{padding:.8rem 0 .5rem;min-width:0}
  .eyebrow,.section-kicker{margin:0 0 .8rem;font-size:.68rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}
  .eyebrow{display:inline-flex;align-items:center;gap:.5rem;padding:.42rem .7rem;border-radius:999px;background:var(--accent-soft)}
  .eyebrow-dot,.live-dot{width:.48rem;height:.48rem;display:inline-block;border-radius:50%;background:#1aaf83}
  .hero-title-row{display:flex;align-items:center;gap:1rem;margin:.45rem 0 .1rem}
  .hero-portrait{display:block;width:clamp(88px,10vw,120px);height:auto;aspect-ratio:1;object-fit:contain;flex:0 0 auto;border:1px solid var(--border);border-radius:1.1rem;background:var(--surface);box-shadow:0 8px 24px rgba(30,70,120,.12)}
  .hero-title-row h1{min-width:0;margin:0;font-size:clamp(2.4rem,3.8vw,4.2rem)!important;line-height:1.02;letter-spacing:-.075em}
  .hero-dash{color:var(--accent);font-weight:400}
  .hero-sanskrit{color:var(--accent);letter-spacing:-.04em}
  .hero-tagline{margin:.3rem 0 1rem;font-size:clamp(1.7rem,2.7vw,2.65rem);line-height:1.12;letter-spacing:-.05em}
  .intro{max-width:37rem;margin:0;font-size:clamp(1rem,1.25vw,1.18rem);line-height:1.55;color:var(--foreground)}
  .generation-counter{display:inline-flex;align-items:center;gap:.5rem;margin:.7rem 0 .25rem;padding:.62rem .9rem;border:1px solid rgba(26,175,131,.32);border-radius:999px;background:var(--accent-soft);color:var(--text);font-size:.9rem;font-weight:800;font-variant-numeric:tabular-nums;box-shadow:0 4px 14px rgba(26,175,131,.08)}
  .counter-dot{width:.55rem;height:.55rem;display:inline-block;flex:0 0 auto;border-radius:50%;background:#1aaf83;box-shadow:0 0 0 3px rgba(26,175,131,.13)}
  .generation-counter::first-line{font-weight:800}
  .sanskrit-quote{display:flex;gap:.7rem;margin:1.35rem 0 1.35rem;padding:0;border:0}
