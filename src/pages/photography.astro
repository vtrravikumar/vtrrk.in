---
import { readFile } from "node:fs/promises";
import { fileURLToPath } from "node:url";
import BaseLayout from "../layouts/BaseLayout.astro";

const catalogPath = fileURLToPath(new URL("../../public/photography/catalog.json", import.meta.url));
const catalog = JSON.parse(await readFile(catalogPath, "utf-8"));
---
<BaseLayout title="Photography — V.T.R. Ravi Kumar" description="Photography by V.T.R. Ravi Kumar.">
  <main>
    <header>
      <p class="label">Photography</p>
      <h1>Photography lives where the photographs belong.</h1>
      <p>Selected photographs, published from my personal archive.</p>
    </header>

    <section class="gallery" aria-label="Photography collection">
      {catalog.map((photo) => (
        <figure>
          <a href={`/photography/${photo.file}`} target="_blank" rel="noopener noreferrer">
            <img
              src={`/photography/${photo.file}`}
              alt={photo.title}
              width={photo.width}
              height={photo.height}
              loading="lazy"
            />
          </a>
          <figcaption>
            <span>{photo.place}</span>
            <span>{photo.title}</span>
          </figcaption>
        </figure>
      ))}
    </section>

    <nav aria-label="Photography links">
      <a href="https://500px.com/vtrrk" target="_blank" rel="noopener noreferrer"><strong>500px</strong><span>Explore the photographic collection →</span></a>
      <a href="https://www.instagram.com/vtrravikumar/" target="_blank" rel="noopener noreferrer"><strong>Instagram</strong><span>Follow the more immediate view →</span></a>
    </nav>
  </main>
</BaseLayout>
<style>
main{width:min(1200px,calc(100% - 3rem));margin:0 auto}
header{padding:8rem 0 5rem;max-width:850px}
h1{margin:0;font-size:clamp(3rem,7vw,6rem);line-height:.98;letter-spacing:-.05em}
header>p:last-child{max-width:650px;color:var(--muted);font-size:1.2rem;line-height:1.7}
.label{color:var(--muted);font-size:.78rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase}
.gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem}
figure{margin:0}
figure a{display:block;overflow:hidden;border-radius:1.25rem;background:color-mix(in srgb,var(--foreground) 5%,transparent)}
img{display:block;width:100%;height:auto}
figcaption{display:flex;justify-content:space-between;gap:1rem;padding:.75rem .25rem 1.5rem;color:var(--muted);font-size:.85rem}
nav{margin-top:2rem;border-top:1px solid color-mix(in srgb,var(--foreground) 15%,transparent)}
nav a{display:flex;justify-content:space-between;gap:2rem;padding:2rem 0;border-bottom:1px solid color-mix(in srgb,var(--foreground) 15%,transparent);color:inherit;text-decoration:none}
nav strong{font-size:1.5rem}
nav span{color:var(--muted);align-self:center}
@media(max-width:700px){main{width:min(100% - 2rem,1200px)}header{padding:5rem 0 3rem}.gallery{grid-template-columns:1fr}nav a{display:block}nav span{display:block;margin-top:.5rem}}
</style>
