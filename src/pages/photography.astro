---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Photography — V.T.R. Ravi Kumar" description="Photography by V.T.R. Ravi Kumar."><main><header><p class="label">Photography</p><h1>Photography lives where the photographs belong.</h1><p>vtrrk.in is the gateway, not the archive. I keep my photographic collections on platforms built for them.</p></header><section><a href="https://500px.com/vtrrk" target="_blank" rel="noopener noreferrer"><strong>500px</strong><span>Explore the photographic collection →</span></a><a href="https://www.instagram.com/vtrravikumar/" target="_blank" rel="noopener noreferrer"><strong>Instagram</strong><span>Follow the more immediate view →</span></a></section></main></BaseLayout>
<style>main{width:min(900px,calc(100% - 3rem));margin:0 auto}header{padding:8rem 0 5rem;max-width:850px}h1{margin:0;font-size:clamp(3rem,7vw,6rem);line-height:.98;letter-spacing:-.05em}header>p:last-child{max-width:650px;color:var(--muted);font-size:1.2rem;line-height:1.7}.label{color:var(--muted);font-size:.78rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase}section{border-top:1px solid color-mix(in srgb,var(--foreground) 15%,transparent)}section a{display:flex;justify-content:space-between;gap:2rem;padding:2.5rem 0;border-bottom:1px solid color-mix(in srgb,var(--foreground) 15%,transparent);color:inherit;text-decoration:none}strong{font-size:2rem}span{color:var(--muted);align-self:center}@media(max-width:600px){main{width:min(100% - 2rem,900px)}header{padding:5rem 0 3rem}section a{display:block}span{display:block;margin-top:.5rem}}
</style>
