---
const navigation = [
  { label: "About", href: "/about/" },
  { label: "Now", href: "/now/" },
  { label: "Books", href: "/books/" },
  { label: "Writing", href: "/writing/" },
  { label: "Projects", href: "/projects/" },
  { label: "Travel", href: "/travel/" },
  { label: "Photography", href: "/photography/" },
];
---

<header class="site-header">
  <a class="brand" href="/" aria-label="V.T.R. Ravi Kumar — Home">VTRRK</a>
  <nav aria-label="Main navigation">
    <ul>
      {navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </nav>
</header>

<style>
  .site-header { width:min(1200px,calc(100% - 3rem)); margin:0 auto; padding:1.5rem 0; display:flex; align-items:center; justify-content:space-between; gap:2rem; }
  .brand { font-size:1rem; font-weight:700; letter-spacing:.12em; text-decoration:none; color:var(--foreground); transition:color .2s ease; }
  .brand:hover { color:var(--accent-creative); }
  nav ul { display:flex; flex-wrap:wrap; gap:1.25rem; list-style:none; margin:0; padding:0; }
  nav a { color:var(--muted); text-decoration:none; font-size:.9rem; transition:color .2s ease; }
  nav a:hover, nav a[aria-current="page"] { color:var(--accent); }
  @media (max-width:800px) { .site-header { align-items:flex-start; flex-direction:column; } nav ul { gap:1rem; } }
</style>
