---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { writingDefaults } from "../content/publishing";
import { shareIntentUrl } from "../utils/share-intent.mjs";

interface Props {
  entry: Awaited<ReturnType<typeof getCollection<"writing">>>[number] | Awaited<ReturnType<typeof getCollection<"writingDrafts">>>[number];
  preview?: boolean;
  previewHeroImage?: string;
}

const { entry, preview = false, previewHeroImage } = Astro.props;
const { Content } = await render(entry);
const { title, description, subtitle, date, type, tags, heroImage, heroImageAlt, glossaryTerms = [], shareText } = entry.data;
const banner = previewHeroImage ?? heroImage ?? writingDefaults.banner;
const bannerAlt = heroImageAlt?.trim() || (heroImage ? title : writingDefaults.bannerAlt);
const canonicalUrl = new URL(`/writing/${entry.id}/`, Astro.site ?? Astro.url).toString();
const socialImage = banner;
const tweetUrl = shareIntentUrl(canonicalUrl, title, shareText ?? `${title}${subtitle ? ` — ${subtitle}` : ""}`);
const glossary = await getCollection("glossary");
const relatedTerms = glossary.filter((term) => glossaryTerms.includes(term.id));
---
<BaseLayout title={`${title} — Writing — V.T.R. Ravi Kumar`} description={description} ogUrl={canonicalUrl} ogImage={socialImage} noindex={preview}>
  <main id="main-content" tabindex="-1">
    <a class="back" href="/writing/">← Writing</a>

    <article>
      {banner && <img class="hero-image" src={banner} alt={bannerAlt} />}
      <header>
        {type && <p class="label">{type}</p>}
        <h1 class="type-page-heading">{title}</h1>
        {subtitle && <p class="subtitle">{subtitle}</p>}
        <p class="description">{description}</p>
        <p class="author">By V.T.R. Ravi Kumar</p>
        {(date || tags?.length) && (
          <div class="meta">
            {date && <time datetime={date.toISOString()}>{date.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}</time>}
            {tags?.length && <span>{tags.join(" · ")}</span>}
          </div>
        )}
      </header>

      <section class="content type-longform">
        <Content />
      </section>

      {relatedTerms.length > 0 && <nav class="glossary-links" aria-label="Related glossary terms"><p>Explore related terms</p>{relatedTerms.map((term) => <a href={`/glossary/${term.id}/`}>{term.data.term}</a>)}</nav>}
      <p class="share"><a href={tweetUrl} target="_blank" rel="noopener noreferrer">Share on X <span aria-hidden="true">↗</span></a></p>
    </article>
  </main>
</BaseLayout>

<style>
main{width:min(1000px,calc(100% - 3rem));margin:0 auto;padding-bottom:7rem}.back{display:inline-block;margin:2rem 0 1.5rem;color:var(--muted);font-size:.9rem;text-decoration:none;transition:color .2s ease}.back:hover{color:var(--foreground)}article{max-width:900px;margin:0 auto}.hero-image{display:block;width:100%;max-height:520px;object-fit:cover;border-radius:3px;margin:1rem 0 3.5rem}header{max-width:780px;padding:3rem 0 4rem}.label{margin:0 0 .8rem;color:var(--muted);font-size:.75rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase}h1{margin:0 0 1.25rem;line-height:.96;letter-spacing:-.045em}.subtitle{max-width:700px;margin:0 0 1rem;font-size:clamp(1.2rem,2.5vw,1.6rem);line-height:1.45;letter-spacing:-.02em}.description{max-width:700px;margin:0;color:var(--muted);font-size:1.18rem;line-height:1.7}.author{margin:.9rem 0 0;color:var(--muted);font-size:.9rem}.meta{display:flex;flex-wrap:wrap;gap:.5rem 1.5rem;margin-top:1.5rem;color:var(--muted);font-size:.78rem}.content{max-width:720px;margin:0 auto}.content :global(h2){margin:3.5rem 0 1rem;font-size:2rem;line-height:1.15;letter-spacing:-.02em}.content :global(h3){margin:2.5rem 0 .75rem;font-size:1.35rem}.content :global(p){margin:0 0 1.4rem}.content :global(ul),.content :global(ol){margin:0 0 1.5rem;padding-left:1.25rem;line-height:1.8}.content :global(blockquote){margin:2.5rem 0;padding-left:1.5rem;border-left:2px solid color-mix(in srgb,var(--foreground) 25%,transparent);color:var(--muted);font-size:1.15rem;line-height:1.7}.content :global(a){text-underline-offset:.2em}.content :global(img){display:block;width:calc(100% + 8rem);max-width:none;margin:3rem -4rem;border-radius:3px}.content :global(figure){margin:3rem 0}.content :global(figure img){width:100%;margin:0}.content :global(figcaption){margin-top:.6rem;color:var(--muted);font-size:.78rem;line-height:1.5}.glossary-links{display:flex;flex-wrap:wrap;align-items:center;gap:.6rem 1rem;margin:2rem 0;color:var(--muted);font-size:.85rem}.glossary-links p{width:100%;margin:0}.glossary-links a{color:var(--foreground);text-underline-offset:.2em}.share{margin:3rem 0 0;padding-top:1.5rem;border-top:1px solid color-mix(in srgb,var(--foreground) 15%,transparent);font-size:.9rem}.share a{color:var(--foreground);text-underline-offset:.3em}.share span{margin-left:.25rem;color:var(--muted)}@media(max-width:600px){main{width:min(100% - 2rem,1000px);padding-bottom:5rem}.back{margin:1.5rem 0 1rem}.hero-image{margin:1rem 0 2.5rem}header{padding:2.5rem 0 3rem}.description{font-size:1.05rem;line-height:1.65}.content{max-width:none}.content :global(h2){margin-top:2.75rem;font-size:1.7rem}.content :global(img){width:100%;margin:2.25rem 0}.content :global(figure){margin:2.25rem 0}}
</style>
